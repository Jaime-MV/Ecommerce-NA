@model IEnumerable<Ecommerce.Datos.Entity.Producto>
@{
    ViewData["Title"] = "Inicio";
    Layout = null;
}
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tú nuevo estilo. Descubre nuestras colecciones destacadas." />
    <title>Ecommerce NA — Innovación y Rendimiento</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        
        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }

        body { background: var(--secondary); color: var(--primary); -webkit-font-smoothing: antialiased; }

        /* -------------------------
           HEADER / NAV
        ------------------------- */
        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }
        .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
        .nav-links a { font-size: 0.95rem; font-weight: 500; color: var(--primary); text-decoration: none; transition: color 0.2s; }
        .nav-links a:hover { color: var(--accent); }
        .nav-actions { display: flex; align-items: center; gap: 1rem; }
        
        /* Botones generales tipo píldora */
        .btn-outline {
            padding: 0.6rem 1.5rem; border: 1px solid var(--primary); border-radius: 9999px;
            color: var(--primary); text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.3s ease; background: transparent; cursor: pointer;
        }
        .btn-outline:hover { background: var(--primary); color: var(--secondary); }
        
        .btn-filled {
            padding: 0.6rem 1.5rem; border: 1px solid var(--accent); border-radius: 9999px;
            background: var(--accent); color: var(--secondary); text-decoration: none; 
            font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease; cursor: pointer;
        }
        .btn-filled:hover { background: #e56000; border-color: #e56000; transform: translateY(-2px); }

        /* -------------------------
           HERO SECTION
        ------------------------- */
        .hero {
            height: 100vh; position: relative;
            display: flex; align-items: flex-end; justify-content: flex-start;
            color: var(--secondary); overflow: hidden;
        }
        .hero-video {
            position: absolute; top: 50%; left: 50%;
            width: 100%; height: 100%; object-fit: cover;
            transform: translate(-50%, -50%); z-index: -2;
        }
        .hero-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.6)); z-index: -1;
        }
        .hero-content {
            position: relative; z-index: 2; padding: 3rem 40px; max-width: 100%;
            text-align: left; margin-bottom: 4rem; align-self: flex-end;
        }
        .hero-subtitle { font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; }
        .hero-title { font-size: 5rem; line-height: 1; margin-bottom: 2rem; font-weight: 700; letter-spacing: -0.02em; }
        
        .cta-container { display: flex; gap: 1rem; flex-wrap: wrap; }
        .cta-button {
            display: inline-block; padding: 0.875rem 2rem; text-decoration: none;
            font-weight: 500; border-radius: 9999px; transition: all 0.3s ease;
            font-size: 1rem; text-align: center;
        }
        .cta-button.primary { background-color: var(--secondary); color: var(--primary); border: none; }
        .cta-button.primary:hover { background-color: #f0f0f0; transform: translateY(-2px); }
        .cta-button.secondary { background-color: transparent; color: var(--secondary); border: 1px solid var(--secondary); }
        .cta-button.secondary:hover { background-color: rgba(255, 255, 255, 0.1); transform: translateY(-2px); }

        /* -------------------------
           CATEGORIES GRID
        ------------------------- */
        .categories-section { padding: 80px 40px; max-width: 1400px; margin: 0 auto; }
        .section-title { text-align: center; font-size: 2.25rem; margin-bottom: 50px; text-transform: uppercase; font-weight: 700; }
        .category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
        .category-card { position: relative; height: 450px; overflow: hidden; cursor: pointer; border-radius: 8px; }
        .category-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
        .category-card:hover img { transform: scale(1.05); }
        .category-info {
            position: absolute; bottom: 0; left: 0; width: 100%; padding: 30px 20px;
            background: linear-gradient(transparent, rgba(158, 77, 1, 0.8));
            color: var(--secondary); display: flex; flex-direction: column; justify-content: flex-end;
        }
        .category-info h3 { margin-bottom: 5px; font-size: 1.75rem; font-weight: 600; }
        .category-info p { font-size: 0.95rem; opacity: 0.9; }

        /* -------------------------
           PRODUCTS SECTION
        ------------------------- */
        .products-section { padding: 40px 40px 80px; max-width: 1400px; margin: 0 auto; background: var(--secondary); }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 40px 20px; }
        .product-card { text-decoration: none; color: var(--primary); display: flex; flex-direction: column; group; }
        .product-img { aspect-ratio: 4/5; background: var(--surface); border-radius: 8px; overflow: hidden; position: relative; margin-bottom: 1rem; }
        .product-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .product-card:hover .product-img img { transform: scale(1.04); }
        .product-badge { position: absolute; top: 1rem; left: 1rem; background: var(--accent); color: var(--secondary); font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.6rem; border-radius: 9999px; z-index: 10; }
        .product-badge.agotado { background: var(--primary); }
        .product-info { display: flex; flex-direction: column; gap: 0.2rem; }
        .product-cat { font-size: 0.8rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
        .product-name { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem; }
        .product-prices { display: flex; align-items: center; gap: 0.5rem; }
        .price { font-weight: 700; font-size: 1.1rem; }
        .price-old { color: #888; text-decoration: line-through; font-size: 0.9rem; }

        /* -------------------------
           FOOTER
        ------------------------- */
        footer { padding: 60px 40px 30px; background: var(--surface); border-top: 1px solid var(--border); }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px; margin-bottom: 40px; max-width: 1400px; margin-inline: auto; }
        .footer-col h4 { font-size: 1.1rem; margin-bottom: 1rem; font-weight: 600; }
        .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
        .footer-col a { color: #555; text-decoration: none; transition: color 0.2s; font-size: 0.95rem; }
        .footer-col a:hover { color: var(--accent); }
        .footer-bottom { text-align: center; border-top: 1px solid var(--border); padding-top: 30px; color: #777; font-size: 0.9rem; }

        /* Responsive */
        @@media (max-width: 992px) {
            .category-grid { grid-template-columns: repeat(2, 1fr); }
            .hero-title { font-size: 4rem; }
        }
        @@media (max-width: 768px) {
            header { padding: 0 20px; }
            .nav-links { display: none; }
            .hero-content { padding: 2rem 20px; }
            .hero-title { font-size: 3rem; }
            .category-grid { grid-template-columns: 1fr; }
            .categories-section { padding: 60px 20px; }
            .products-section { padding: 40px 20px; }
            .cta-button { padding: 0.75rem 1.5rem; width: 100%; margin-bottom: 0.5rem; }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <ul class="nav-links">
            <li><a href="#colecciones">Colecciones</a></li>
            <li><a href="#productos">Catálogo</a></li>
            <li><a href="#">Lanzamientos</a></li>
        </ul>
        <div class="nav-actions">
            @if (SignInManager.IsSignedIn(User))
            {
                var usuario = await UserManager.GetUserAsync(User);
                <a asp-controller="Account" asp-action="Perfil" class="btn-outline" style="border:none;">Perfil</a>
                <a asp-controller="Account" asp-action="MisPedidos" class="btn-outline" style="border:none;">Mis pedidos</a>
                <a asp-controller="Carrito" asp-action="Index" class="btn-filled">Carrito</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="btn-outline">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-outline" style="border:none;">Ingresar</a>
                <a asp-controller="Account" asp-action="Register" class="btn-filled">Únete ahora</a>
            }
        </div>
    </header>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-subtitle">Tú nuevo estilo</p>
            <h1 class="hero-title">The Cloud 6</h1>
            <div class="cta-container">
                <a href="#productos" class="cta-button primary">Compra ahora</a>
                <a href="#colecciones" class="cta-button secondary">Descubre nuevos estilos</a>
            </div>
        </div>
        <video autoplay loop muted playsinline class="hero-video">
            <source src="https://videos.ctfassets.net/hnk2vsx53n6l/6QADM6c6JzLVUd5kiJhmMd/2a30a8c335ae0238493c8ddb51797bfe/cloud6-atm-mobile_1.mp4" type="video/mp4">
        </video>
    </section>

    <!-- CATEGORIES -->
    <section id="colecciones" class="categories-section">
        <h2 class="section-title">Nuestras colecciones destacadas</h2>
        <div class="category-grid">
            <div class="category-card" onclick="window.location.href='#productos'">
                <img src="https://images.ctfassets.net/hnk2vsx53n6l/6XIM4x251TmdLPO9JJ5aA2/15f53a20b1f693bfc382c1421987544b/ss25-trade_assets-po-detail_still-look_9_ultra_t_m_hd_rgb-04.jpg?w=900&h=1200&fm=avif&fit=fill&q=80" alt="Hombres">
                <div class="category-info">
                    <h3>Hombres</h3>
                    <p>Explora nuestra colección masculina.</p>
                </div>
            </div>
            <div class="category-card" onclick="window.location.href='#productos'">
                <img src="https://images.ctfassets.net/hnk2vsx53n6l/1fxgjcU1NKMZEHjsH7ha2D/46dae934da001068f054dd54aaa9d02f/Medium_JPEG-ss24-internationaux-pte-portrait_still-iga_swiatek-05__1_.jpg?w=900&h=1200&fm=avif&fit=fill&q=80" alt="Mujeres">
                <div class="category-info">
                    <h3>Mujeres</h3>
                    <p>Descubre nuestros modelos femeninos.</p>
                </div>
            </div>
            <div class="category-card" onclick="window.location.href='#productos'">
                <img src="https://images.ctfassets.net/hnk2vsx53n6l/2nF4papz03q2hPJIzWfmoJ/a15a2958c5f0184064fed5af48cadf1b/ss25-trade_assets-pad-head_to_toe_still-look_5_web_srgb-01.jpg?w=900&h=1200&fm=avif&fit=fill&q=80" alt="Novedades">
                <div class="category-info">
                    <h3>Novedades</h3>
                    <p>Los últimos lanzamientos de temporada.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PRODUCTS -->
    <section id="productos" class="products-section">
        <h2 class="section-title">Productos Destacados</h2>
        <div class="products-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (var p in Model)
                {
                    var stockTotal = p.Variantes?.Sum(v => v.Stock) ?? 0;
                    var fallbackImg = "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=600&auto=format&fit=crop";
                    
                    <a href="/Producto/Detalle/@p.Id" class="product-card">
                        <div class="product-img">
                            <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? fallbackImg : p.ImagenUrl)" 
                                 alt="@p.Nombre" loading="lazy" 
                                 onerror="this.onerror=null; this.src='@fallbackImg';" />
                            
                            @if (p.PorcentajeDescuento > 0)
                            {
                                <div class="product-badge">-@p.PorcentajeDescuento%</div>
                            }
                            else if (stockTotal == 0)
                            {
                                <div class="product-badge agotado" style="background:var(--primary);">Agotado</div>
                            }
                        </div>
                        <div class="product-info">
                            <span class="product-cat">@(p.Categoria?.Nombre ?? "Calzado")</span>
                            <span class="product-name">@p.Nombre</span>
                            <div class="product-prices">
                                @if (p.PorcentajeDescuento > 0)
                                {
                                    var precioFinal = p.PrecioOriginal * (1 - (decimal)p.PorcentajeDescuento / 100);
                                    <span class="price">$@precioFinal.ToString("N2")</span>
                                    <span class="price-old">$@p.PrecioOriginal.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="price">$@p.PrecioOriginal.ToString("N2")</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div style="grid-column: 1/-1; text-align: center; padding: 4rem; color: #666;">
                    No hay productos disponibles por el momento.
                </div>
            }
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-grid">
            <div class="footer-col">
                <a href="/" style="font-size:1.5rem; font-weight:700; color:var(--primary); text-decoration:none; text-transform:uppercase; letter-spacing:-0.02em;">Ecommerce NA</a>
                <p style="margin-top:1rem; color:#666; font-size:0.95rem;">Innovación y rendimiento en cada paso.</p>
            </div>
            <div class="footer-col">
                <h4>Comprar</h4>
                <ul>
                    <li><a href="#productos">Hombres</a></li>
                    <li><a href="#productos">Mujeres</a></li>
                    <li><a href="#productos">Lanzamientos</a></li>
                    <li><a href="#productos">Ofertas</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Asistencia</h4>
                <ul>
                    <li><a href="#">Centro de ayuda</a></li>
                    <li><a href="#">Devoluciones</a></li>
                    <li><a href="#">Envíos y entregas</a></li>
                    <li><a href="#">Opciones de pago</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year Ecommerce NA. Todos los derechos reservados.</span>
        </div>
    </footer>

</body>
</html>
