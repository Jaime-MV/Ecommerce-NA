@model Ecommerce.Datos.Entity.Producto
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@{
    ViewData["Title"] = Model.Nombre;
    Layout = null;

    var precioFinal = Model.PorcentajeDescuento > 0
        ? Model.PrecioOriginal * (1 - (decimal)Model.PorcentajeDescuento / 100)
        : Model.PrecioOriginal;

    var stockTotal = Model.Variantes.Sum(v => v.Stock);

    var placeholders = new[] {
        "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1560769629-975ec94e6a86?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1608231387042-66d1773070a5?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1551107696-a4b0c5a0d1a6?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1595341888016-a392ef81b7de?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1605348532760-6753d2c43329?q=80&w=800&auto=format&fit=crop"
    };
    var imgUrl = string.IsNullOrEmpty(Model.ImagenUrl) ? placeholders[Model.Id % placeholders.Length] : Model.ImagenUrl;
    bool isSignedIn = (bool)(ViewBag.IsSignedIn ?? false);
    int itemsEnCarrito = (int)(ViewBag.ItemsEnCarrito ?? 0);

    var variantesPorTalla = Model.Variantes
        .Where(v => v.Stock > 0)
        .GroupBy(v => v.Talla)
        .OrderBy(g => g.Key)
        .ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(Model.Descripcion ?? Model.Nombre + " — Ecommerce NA")" />
    <title>@Model.Nombre — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }
        body { background: var(--secondary); color: var(--primary); -webkit-font-smoothing: antialiased; }

        /* HEADER / NAV */
        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }
        .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
        .nav-links a { font-size: 0.95rem; font-weight: 500; color: var(--primary); text-decoration: none; transition: color 0.2s; }
        .nav-links a:hover { color: var(--accent); }
        .nav-actions { display: flex; align-items: center; gap: 1rem; }
        
        .btn-outline {
            padding: 0.6rem 1.5rem; border: 1px solid var(--primary); border-radius: 9999px;
            color: var(--primary); text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.3s ease; background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .btn-outline:hover { background: var(--primary); color: var(--secondary); }
        .btn-filled {
            padding: 0.6rem 1.5rem; border: 1px solid var(--accent); border-radius: 9999px;
            background: var(--accent); color: var(--secondary); text-decoration: none; 
            font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .btn-filled:hover { background: #e56000; border-color: #e56000; transform: translateY(-2px); }

        .cart-badge {
            background: var(--primary); color: var(--secondary);
            font-size: 0.65rem; font-weight: 700; border-radius: 50%; width: 22px; height: 22px;
            display: flex; align-items: center; justify-content: center; margin-left: 0.3rem;
        }
        .btn-filled .cart-badge { background: var(--secondary); color: var(--accent); }

        /* BREADCRUMB */
        .breadcrumb-bar {
            padding: calc(var(--nav-h) + 20px) 40px 0;
            display: flex; align-items: center; gap: 0.6rem; max-width: 1400px; margin: 0 auto;
        }
        .breadcrumb-bar a { font-size: 0.85rem; color: #666; text-decoration: none; font-weight: 500; transition: color 0.2s; }
        .breadcrumb-bar a:hover { color: var(--accent); }
        .breadcrumb-sep { color: #aaa; font-size: 0.85rem; }
        .breadcrumb-bar span { font-size: 0.85rem; color: var(--primary); font-weight: 600; }

        /* PRODUCT LAYOUT */
        .product-main {
            display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
            max-width: 1400px; margin: 20px auto 80px; padding: 0 40px; min-height: 70vh;
        }

        /* Image Panel */
        .prod-img-panel { position: relative; border-radius: 12px; overflow: hidden; background: var(--surface); }
        .prod-img-panel img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 600px; }
        .prod-badge-discount { position: absolute; top: 1.5rem; left: 1.5rem; background: var(--accent); color: var(--secondary); font-size: 0.8rem; font-weight: 700; padding: 0.4rem 1rem; border-radius: 9999px; }
        .prod-badge-agotado { position: absolute; top: 1.5rem; right: 1.5rem; background: var(--primary); color: var(--secondary); font-size: 0.8rem; font-weight: 700; padding: 0.4rem 1rem; border-radius: 9999px; }

        /* Info Panel */
        .prod-info-panel { display: flex; flex-direction: column; gap: 1.5rem; justify-content: center; }
        .prod-category { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: #666; letter-spacing: 0.05em; }
        .prod-title { font-size: 3.5rem; font-weight: 700; line-height: 1.1; color: var(--primary); letter-spacing: -0.02em; }
        .prod-desc { font-size: 1.05rem; line-height: 1.6; color: #555; }
        
        .price-block { display: flex; align-items: baseline; gap: 1rem; }
        .price-orig { font-size: 1.25rem; color: #888; text-decoration: line-through; }
        .price-final { font-size: 2.5rem; font-weight: 700; color: var(--primary); }
        
        /* Variantes */
        .variants-section { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 10px; }
        .variants-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: #666; margin-bottom: 10px; }
        .variants-label span { color: var(--primary); font-weight: 700; margin-left: 0.5rem; }
        
        .tallas-grid { display: flex; flex-wrap: wrap; gap: 10px; }
        .talla-btn {
            min-width: 60px; padding: 0.6rem 1rem; border: 1px solid var(--border); background: var(--secondary); color: var(--primary);
            font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600; cursor: pointer; border-radius: 8px; transition: all 0.2s;
        }
        .talla-btn:hover { border-color: var(--primary); }
        .talla-btn.selected { border-color: var(--primary); background: var(--primary); color: var(--secondary); }

        .color-blocks { display: flex; flex-wrap: wrap; gap: 10px; }
        .color-block-btn {
            display: flex; align-items: center; gap: 8px; padding: 0.5rem 1rem; border: 1px solid var(--border);
            background: var(--secondary); color: var(--primary); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; cursor: pointer; border-radius: 8px; transition: all 0.2s;
        }
        .color-block-btn:hover { border-color: var(--primary); }
        .color-block-btn.selected { border-color: var(--primary); background: var(--surface); font-weight: 700; }
        .color-dot-sm { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); }

        /* Cantidad */
        .qty-block { display: flex; align-items: center; gap: 1rem; }
        .qty-control {
            display: flex; align-items: center; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
        }
        .qty-btn {
            width: 44px; height: 44px; background: var(--surface); border: none; font-size: 1.25rem; cursor: pointer; transition: background 0.2s; display: flex; align-items: center; justify-content: center;
        }
        .qty-btn:hover { background: #e0e0e0; }
        #qty-input {
            width: 54px; height: 44px; text-align: center; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border);
            background: var(--secondary); font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600;
        }

        .btn-add-cart {
            display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 1.2rem;
            background: var(--accent); color: var(--secondary); border: none; border-radius: 9999px; font-family: 'Inter', sans-serif;
            font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; margin-top: 10px;
        }
        .btn-add-cart:hover { background: #e56000; transform: translateY(-2px); }
        .btn-add-cart:disabled { background: var(--surface); color: #999; border: 1px solid var(--border); cursor: not-allowed; transform: none; }

        .btn-login-required {
            display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; padding: 1.2rem;
            background: transparent; border: 1px solid var(--primary); color: var(--primary); border-radius: 9999px;
            font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; text-decoration: none; transition: all 0.3s ease; margin-top: 10px;
        }
        .btn-login-required:hover { background: var(--primary); color: var(--secondary); transform: translateY(-2px); }

        .login-notice {
            display: flex; align-items: flex-start; gap: 0.8rem; padding: 15px; background: var(--surface); border-radius: 8px; border: 1px solid var(--border); margin-top: 10px;
        }
        .login-notice p { font-size: 0.95rem; line-height: 1.5; color: #555; margin: 0; }
        .login-notice a { color: var(--accent); font-weight: 600; }

        .meta-list { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border); }
        .meta-row { display: flex; justify-content: space-between; font-size: 0.95rem; }
        .meta-key { color: #666; font-weight: 500; }
        .meta-val { font-weight: 600; }

        /* Alerts */
        .alert-box { padding: 1rem 1.5rem; border-radius: 8px; font-weight: 500; }
        .alert-box.success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .alert-box.error { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }

        @@media (max-width: 900px) {
            .product-main { grid-template-columns: 1fr; }
            header { padding: 0 20px; }
            .breadcrumb-bar { padding: calc(var(--nav-h) + 20px) 20px 0; }
            .product-main { padding: 0 20px; }
            .prod-title { font-size: 2.5rem; }
            .prod-img-panel img { min-height: 400px; }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <div class="nav-actions">
            @if (isSignedIn)
            {
                <a asp-controller="Account" asp-action="MisPedidos" class="btn-outline" style="border:none;">Mis pedidos</a>
                <a asp-controller="Carrito" asp-action="Index" class="btn-filled">
                    Carrito
                    @if (itemsEnCarrito > 0)
                    {
                        <span class="cart-badge">@itemsEnCarrito</span>
                    }
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="btn-outline" style="border:none;">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-outline" style="border:none;">Iniciar Sesión</a>
                <a asp-controller="Account" asp-action="Register" class="btn-outline">Registrarse</a>
            }
        </div>
    </header>

    <div class="breadcrumb-bar">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/#productos">Catálogo</a>
        <span class="breadcrumb-sep">/</span>
        <span>@Model.Nombre</span>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div style="max-width: 1400px; margin: 20px auto 0; padding: 0 40px;">
            <div class="alert-box success">✓ @TempData["Exito"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="max-width: 1400px; margin: 20px auto 0; padding: 0 40px;">
            <div class="alert-box error">✕ @TempData["Error"]</div>
        </div>
    }

    <div class="product-main">
        <div class="prod-img-panel">
            <img src="@imgUrl" alt="@Model.Nombre" onerror="this.onerror=null;this.src='@imgUrl';" />
            @if (Model.PorcentajeDescuento > 0){ <div class="prod-badge-discount">-@Model.PorcentajeDescuento%</div> }
            @if (stockTotal == 0){ <div class="prod-badge-agotado">Agotado</div> }
        </div>

        <div class="prod-info-panel">
            <div>
                <div class="prod-category">@(Model.Categoria?.Nombre ?? "Producto") — @(Model.Genero ?? "Universal")</div>
                <h1 class="prod-title">@Model.Nombre</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.Descripcion)) { <p class="prod-desc">@Model.Descripcion</p> }

            <div class="price-block">
                @if (Model.PorcentajeDescuento > 0)
                {
                    <span class="price-orig">$@Model.PrecioOriginal.ToString("N2")</span>
                    <span class="price-final">$@precioFinal.ToString("N2")</span>
                }
                else
                {
                    <span class="price-final">$@precioFinal.ToString("N2")</span>
                }
            </div>

            @if (stockTotal > 0)
            {
                <form id="add-cart-form" asp-controller="Carrito" asp-action="Agregar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoVarianteId" id="variante-id-input" value="" />
                    <input type="hidden" name="returnUrl" value="/Producto/Detalle/@Model.Id" />

                    <div class="variants-section">
                        <div>
                            <div class="variants-label">Talla: <span id="talla-selected-label">Ninguna seleccionada</span></div>
                            <div class="tallas-grid" id="tallas-container">
                                @{
                                    var tallasUnicas = Model.Variantes.Where(v => v.Stock > 0).Select(v => v.Talla).Distinct().OrderBy(t => t).ToList();
                                }
                                @foreach (var talla in tallasUnicas)
                                {
                                    <button type="button" class="talla-btn" data-talla="@talla" onclick="seleccionarTalla(this)">@talla</button>
                                }
                            </div>
                        </div>

                        <div id="color-section" style="display:none">
                            <div class="variants-label">Color: <span id="color-selected-label">Ninguno seleccionado</span></div>
                            <div class="color-blocks" id="colores-container"></div>
                        </div>

                        <div id="qty-section" style="display:none">
                            <div class="variants-label">Cantidad</div>
                            <div class="qty-block">
                                <div class="qty-control">
                                    <button type="button" class="qty-btn" onclick="cambiarCantidad(-1)">−</button>
                                    <input type="number" id="qty-input" name="Cantidad" value="1" min="1" max="99" readonly />
                                    <button type="button" class="qty-btn" onclick="cambiarCantidad(1)">+</button>
                                </div>
                                <div class="stock-info" id="stock-info-text">— uds. disponibles</div>
                            </div>
                        </div>
                    </div>

                    @if (!isSignedIn)
                    {
                        <div class="login-notice">
                            <p><strong>Atención:</strong> Necesitas una cuenta para comprar. <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Producto/Detalle/@Model.Id">Iniciar sesión</a> o <a asp-controller="Account" asp-action="Register">Registrarse</a>.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Producto/Detalle/@Model.Id" class="btn-login-required">
                            Inicia sesión para poder comprar
                        </a>
                    }
                    else
                    {
                        <button type="submit" class="btn-add-cart" id="btn-agregar" disabled>
                            Debes seleccionar una Talla y Color
                        </button>
                    }
                </form>
            }
            else
            {
                <div class="alert-box error" style="margin-top: 20px;">
                    Lo sentimos, este artículo se encuentra agotado por el momento.
                </div>
            }

            <div class="meta-list">
                <div class="meta-row">
                    <span class="meta-key">Categoría</span>
                    <span class="meta-val">@(Model.Categoria?.Nombre ?? "—")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-key">Stock total en tienda</span>
                    <span class="meta-val" style="color:@(stockTotal > 0 ? "#2e7d32" : "#c62828")">@stockTotal unidades</span>
                </div>
                @if (Model.OfertaFin.HasValue)
                {
                    <div class="meta-row">
                        <span class="meta-key">La oferta termina el</span>
                        <span class="meta-val">@Model.OfertaFin.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>

        </div>
    </div>

    <script>
        const variantes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Variantes.Where(v => v.Stock > 0).Select(v => new { id = v.Id, talla = v.Talla, color = v.Color ?? "Único", stock = v.Stock })
        ));

        let tallaSel = null;
        let colorSel = null;
        let maxStock = 0;

        function colorToCss(nombre) {
            const map = {
                'negro':'#222','blanco':'#f0f0f0', 'rojo':'#c0392b','azul':'#2980b9',
                'café':'#6d4c2a','gris':'#7f8c8d','beige':'#d2b48c','verde':'#27ae60',
                'amarillo':'#f1c40f','naranja':'#e67e22','morado':'#8e44ad','rosa':'#e91e8c',
                'dorado':'#c9a96e','único':'#ccc'
            };
            return map[(nombre||'').toLowerCase()] || '#555';
        }

        function seleccionarTalla(btn) {
            document.querySelectorAll('.talla-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            tallaSel = btn.getAttribute('data-talla');
            colorSel = null;
            document.getElementById('talla-selected-label').textContent = tallaSel;
            document.getElementById('variante-id-input').value = '';

            const coloresParaTalla = variantes.filter(v => v.talla === tallaSel);
            const coloresContainer = document.getElementById('colores-container');
            coloresContainer.innerHTML = '';
            
            coloresParaTalla.forEach(v => {
                const btn2 = document.createElement('button');
                btn2.type = 'button'; btn2.className = 'color-block-btn';
                btn2.setAttribute('data-variante-id', v.id); btn2.setAttribute('data-color', v.color); btn2.setAttribute('data-stock', v.stock);
                btn2.innerHTML = `<span class="color-dot-sm" style="background:${colorToCss(v.color)}"></span>${v.color}`;
                btn2.onclick = () => seleccionarColor(btn2);
                coloresContainer.appendChild(btn2);
            });

            document.getElementById('color-section').style.display = 'block';
            document.getElementById('color-selected-label').textContent = 'Ninguno seleccionado';
            document.getElementById('qty-section').style.display = 'none';
            actualizarBotonAgregar();
        }

        function seleccionarColor(btn) {
            document.querySelectorAll('.color-block-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            colorSel = btn.getAttribute('data-color');
            const varianteId = btn.getAttribute('data-variante-id');
            maxStock = parseInt(btn.getAttribute('data-stock'));

            document.getElementById('color-selected-label').textContent = colorSel;
            document.getElementById('variante-id-input').value = varianteId;

            document.getElementById('qty-section').style.display = 'block';
            document.getElementById('qty-input').max = maxStock;
            document.getElementById('qty-input').value = 1;
            document.getElementById('stock-info-text').textContent = maxStock + ' uds. disponibles';

            actualizarBotonAgregar();
        }

        function cambiarCantidad(delta) {
            const input = document.getElementById('qty-input');
            const current = parseInt(input.value) || 1;
            input.value = Math.max(1, Math.min(maxStock, current + delta));
        }

        function actualizarBotonAgregar() {
            const btn = document.getElementById('btn-agregar');
            if (!btn) return;
            if (tallaSel && colorSel) {
                btn.disabled = false;
                btn.innerHTML = `Agregar al Carrito`;
            } else {
                btn.disabled = true;
                btn.innerHTML = `Debes seleccionar una Talla y Color`;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const tallasBtns = document.querySelectorAll('.talla-btn');
            if (tallasBtns.length === 1) seleccionarTalla(tallasBtns[0]);
        });
    </script>
</body>
</html>
