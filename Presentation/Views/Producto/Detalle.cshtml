@model Ecommerce.Datos.Entity.Producto
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@{
    ViewData["Title"] = Model.Nombre;
    Layout = null;

    var precioFinal = Model.PorcentajeDescuento > 0
        ? Model.PrecioOriginal * (1 - (decimal)Model.PorcentajeDescuento / 100)
        : Model.PrecioOriginal;

    var stockTotal = Model.Variantes.Sum(v => v.Stock);

    var placeholders = new[] {
        "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1560769629-975ec94e6a86?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1608231387042-66d1773070a5?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1551107696-a4b0c5a0d1a6?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1595341888016-a392ef81b7de?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1605348532760-6753d2c43329?q=80&w=800&auto=format&fit=crop"
    };
    var imgUrl = string.IsNullOrEmpty(Model.ImagenUrl) ? placeholders[Model.Id % placeholders.Length] : Model.ImagenUrl;
    bool isSignedIn = (bool)(ViewBag.IsSignedIn ?? false);
    int itemsEnCarrito = (int)(ViewBag.ItemsEnCarrito ?? 0);

    // Agrupar variantes por talla y color
    var variantesPorTalla = Model.Variantes
        .Where(v => v.Stock > 0)
        .GroupBy(v => v.Talla)
        .OrderBy(g => g.Key)
        .ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(Model.Descripcion ?? Model.Nombre + " — Ecommerce NA")" />
    <title>@Model.Nombre — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:        #0a0a0b;
            --surface:   #111113;
            --surface2:  #161618;
            --border:    rgba(255,255,255,0.08);
            --gold:      #c9a96e;
            --gold-dim:  #8a6d3b;
            --gold-pale: rgba(201,169,110,0.12);
            --text:      #e8e3db;
            --muted:     #6b6560;
            --light:     #a09890;
            --nav-h:     70px;
            --success:   #4caf7d;
            --danger:    #e05a5a;
        }

        html { scroll-behavior: smooth; }
        body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; overflow-x: hidden; }

        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
        }

        /* ── NAV ── */
        nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: var(--nav-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 3.5rem;
            background: rgba(10,10,11,0.92);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
        }
        .nav-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.45rem; font-weight: 300;
            letter-spacing: 0.3em; text-transform: uppercase;
            color: var(--gold); text-decoration: none;
        }
        .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
        .nav-links a {
            font-size: 0.78rem; letter-spacing: 0.13em; text-transform: uppercase;
            color: var(--light); text-decoration: none; transition: color 0.2s;
        }
        .nav-links a:hover { color: var(--gold); }
        .nav-cart {
            position: relative;
            display: flex; align-items: center; gap: 0.5rem;
            padding: 0.5rem 1.2rem;
            border: 1px solid var(--gold); color: var(--gold);
            border-radius: 1px; text-decoration: none;
            font-size: 0.78rem; letter-spacing: 0.13em; text-transform: uppercase;
            transition: background 0.25s, color 0.25s;
        }
        .nav-cart:hover { background: var(--gold); color: var(--bg); }
        .cart-badge {
            background: var(--gold); color: var(--bg);
            font-size: 0.65rem; font-weight: 700;
            border-radius: 50%; width: 18px; height: 18px;
            display: flex; align-items: center; justify-content: center;
            margin-left: 0.2rem;
        }

        /* ── BREADCRUMB ── */
        .breadcrumb-bar {
            position: relative; z-index: 1;
            padding: calc(var(--nav-h) + 2rem) 3.5rem 0;
            display: flex; align-items: center; gap: 0.6rem;
        }
        .breadcrumb-bar a { font-size: 0.75rem; color: var(--muted); text-decoration: none; letter-spacing: 0.08em; transition: color 0.2s; }
        .breadcrumb-bar a:hover { color: var(--gold); }
        .breadcrumb-sep { color: var(--muted); font-size: 0.75rem; }
        .breadcrumb-bar span { font-size: 0.75rem; color: var(--light); letter-spacing: 0.08em; }

        /* ── PRODUCT LAYOUT ── */
        .product-main {
            position: relative; z-index: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            min-height: 80vh;
            margin-top: 2rem;
        }

        /* Image Panel */
        .prod-img-panel {
            position: relative;
            background: #1a1810;
            overflow: hidden;
        }
        .prod-img-panel img {
            width: 100%; height: 100%;
            object-fit: cover;
            display: block;
            min-height: 520px;
        }
        .prod-badge-discount {
            position: absolute; top: 1.5rem; left: 1.5rem;
            background: var(--gold); color: var(--bg);
            font-size: 0.75rem; font-weight: 700;
            letter-spacing: 0.12em; text-transform: uppercase;
            padding: 0.35rem 0.8rem; border-radius: 1px;
        }
        .prod-badge-agotado {
            position: absolute; top: 1.5rem; right: 1.5rem;
            background: rgba(224,90,90,0.9); color: #fff;
            font-size: 0.75rem; font-weight: 700;
            letter-spacing: 0.12em; text-transform: uppercase;
            padding: 0.35rem 0.8rem; border-radius: 1px;
        }

        /* Info Panel */
        .prod-info-panel {
            padding: 3.5rem;
            background: var(--surface);
            border-left: 1px solid var(--border);
            display: flex; flex-direction: column; gap: 1.8rem;
        }
        .prod-category {
            font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase;
            color: var(--gold);
        }
        .prod-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2rem, 3.5vw, 3rem);
            font-weight: 300; line-height: 1.1;
            color: var(--text);
        }
        .prod-desc {
            font-size: 0.95rem; line-height: 1.75;
            color: var(--light);
        }
        .price-block { display: flex; align-items: baseline; gap: 1rem; }
        .price-orig {
            font-size: 1rem; color: var(--muted);
            text-decoration: line-through;
        }
        .price-final {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.4rem; font-weight: 300;
            color: var(--gold);
        }
        .price-discount-tag {
            background: var(--gold-pale); color: var(--gold);
            font-size: 0.72rem; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase;
            padding: 0.2rem 0.6rem; border-radius: 2px;
        }

        /* Variantes */
        .variants-section { display: flex; flex-direction: column; gap: 1rem; }
        .variants-label {
            font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
            color: var(--muted);
        }
        .variants-label span { color: var(--text); margin-left: 0.5rem; }
        .tallas-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .talla-btn {
            min-width: 52px; padding: 0.55rem 0.8rem;
            border: 1px solid var(--border);
            background: transparent; color: var(--light);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem; letter-spacing: 0.05em;
            cursor: pointer; border-radius: 1px;
            transition: border-color 0.2s, color 0.2s, background 0.2s;
        }
        .talla-btn:hover { border-color: var(--gold); color: var(--gold); }
        .talla-btn.selected { border-color: var(--gold); background: var(--gold-pale); color: var(--gold); }
        .talla-btn:disabled { opacity: 0.3; cursor: not-allowed; }

        .color-blocks { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .color-block-btn {
            display: flex; align-items: center; gap: 0.5rem;
            padding: 0.45rem 0.9rem;
            border: 1px solid var(--border);
            background: transparent; color: var(--light);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem; cursor: pointer; border-radius: 1px;
            transition: border-color 0.2s, color 0.2s;
        }
        .color-block-btn:hover { border-color: var(--gold); color: var(--gold); }
        .color-block-btn.selected { border-color: var(--gold); color: var(--gold); background: var(--gold-pale); }
        .color-dot-sm {
            width: 10px; height: 10px; border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Cantidad */
        .qty-block { display: flex; align-items: center; gap: 1rem; }
        .qty-control {
            display: flex; align-items: center;
            border: 1px solid var(--border); border-radius: 1px;
            overflow: hidden;
        }
        .qty-btn {
            width: 38px; height: 38px;
            background: transparent; border: none;
            color: var(--light); font-size: 1.1rem;
            cursor: pointer; transition: background 0.2s, color 0.2s;
            display: flex; align-items: center; justify-content: center;
        }
        .qty-btn:hover { background: var(--gold-pale); color: var(--gold); }
        #qty-input {
            width: 50px; height: 38px;
            text-align: center; border: none;
            background: var(--surface2); color: var(--text);
            font-family: 'DM Sans', sans-serif; font-size: 0.9rem;
        }
        #qty-input:focus { outline: none; }
        .stock-info { font-size: 0.78rem; color: var(--muted); }

        /* Add to cart btn */
        .btn-add-cart {
            display: flex; align-items: center; justify-content: center; gap: 0.7rem;
            width: 100%; padding: 1rem 2rem;
            background: var(--gold); color: var(--bg);
            border: none; border-radius: 1px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem; font-weight: 500;
            letter-spacing: 0.2em; text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.25s, transform 0.25s;
        }
        .btn-add-cart:hover { opacity: 0.88; transform: translateY(-1px); }
        .btn-add-cart:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }

        .btn-login-required {
            display: flex; align-items: center; justify-content: center; gap: 0.7rem;
            width: 100%; padding: 1rem 2rem;
            background: transparent;
            border: 1px solid var(--gold); color: var(--gold);
            border-radius: 1px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem; font-weight: 500;
            letter-spacing: 0.2em; text-transform: uppercase;
            text-decoration: none;
            transition: background 0.25s, color 0.25s;
        }
        .btn-login-required:hover { background: var(--gold); color: var(--bg); }

        /* Login notice */
        .login-notice {
            display: flex; align-items: flex-start; gap: 0.8rem;
            padding: 1rem 1.2rem;
            background: rgba(201,169,110,0.06);
            border: 1px solid rgba(201,169,110,0.2);
            border-radius: 2px;
        }
        .login-notice svg { flex-shrink: 0; margin-top: 1px; color: var(--gold); }
        .login-notice p { font-size: 0.82rem; line-height: 1.55; color: var(--light); }
        .login-notice a { color: var(--gold); text-decoration: underline; }

        /* Alerts */
        .alert-box {
            padding: 0.85rem 1.2rem; border-radius: 2px;
            font-size: 0.85rem; line-height: 1.4;
        }
        .alert-box.success { background: rgba(76,175,125,0.1); border: 1px solid rgba(76,175,125,0.3); color: var(--success); }
        .alert-box.error { background: rgba(224,90,90,0.1); border: 1px solid rgba(224,90,90,0.3); color: var(--danger); }

        /* Meta info */
        .meta-list { display: flex; flex-direction: column; gap: 0.6rem; }
        .meta-row {
            display: flex; justify-content: space-between; align-items: center;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid var(--border);
            font-size: 0.82rem;
        }
        .meta-row:last-child { border-bottom: none; }
        .meta-key { color: var(--muted); letter-spacing: 0.06em; }
        .meta-val { color: var(--text); font-weight: 400; }

        /* Responsive */
        @@media (max-width: 900px) {
            .product-main { grid-template-columns: 1fr; }
            .prod-info-panel { border-left: none; border-top: 1px solid var(--border); }
            nav { padding: 0 1.5rem; }
            .breadcrumb-bar { padding-left: 1.5rem; padding-right: 1.5rem; }
        }
        @@media (max-width: 768px) {
            .prod-info-panel { padding: 2rem 1.5rem; }
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .prod-info-panel > * {
            animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
        }
        .prod-info-panel > *:nth-child(1) { animation-delay: 0.05s; }
        .prod-info-panel > *:nth-child(2) { animation-delay: 0.1s; }
        .prod-info-panel > *:nth-child(3) { animation-delay: 0.15s; }
        .prod-info-panel > *:nth-child(4) { animation-delay: 0.2s; }
        .prod-info-panel > *:nth-child(5) { animation-delay: 0.25s; }
        .prod-info-panel > *:nth-child(6) { animation-delay: 0.3s; }
        .prod-info-panel > *:nth-child(7) { animation-delay: 0.35s; }
    </style>
</head>
<body>

    <!-- ── NAV ── -->
    <nav>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <ul class="nav-links">
            <li><a href="/#productos">Colección</a></li>
            @if (isSignedIn)
            {
                <li><a asp-controller="Account" asp-action="MisPedidos">Mis Pedidos</a></li>
                <li>
                    <a asp-controller="Carrito" asp-action="Index" class="nav-cart" id="nav-cart-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                        </svg>
                        Carrito
                        @if (itemsEnCarrito > 0)
                        {
                            <span class="cart-badge">@itemsEnCarrito</span>
                        }
                    </a>
                </li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        <button type="submit" style="background:none;border:none;font-family:'DM Sans',sans-serif;font-size:0.78rem;letter-spacing:0.13em;text-transform:uppercase;cursor:pointer;color:var(--light);transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--light)'">Salir</button>
                    </form>
                </li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                <li><a asp-controller="Account" asp-action="Register" style="padding:0.5rem 1.2rem;border:1px solid var(--gold);color:var(--gold);border-radius:1px;transition:background 0.25s,color 0.25s;" onmouseover="this.style.background='var(--gold)';this.style.color='var(--bg)'" onmouseout="this.style.background='transparent';this.style.color='var(--gold)'">Registrarse</a></li>
            }
        </ul>
    </nav>

    <!-- ── BREADCRUMB ── -->
    <div class="breadcrumb-bar">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/#productos">Catálogo</a>
        <span class="breadcrumb-sep">›</span>
        <span>@Model.Nombre</span>
    </div>

    <!-- ── TEMPDATA ALERTS ── -->
    @if (TempData["Exito"] != null)
    {
        <div style="position:relative;z-index:1;padding:0 3.5rem;margin-top:1rem">
            <div class="alert-box success">✓ @TempData["Exito"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="position:relative;z-index:1;padding:0 3.5rem;margin-top:1rem">
            <div class="alert-box error">✕ @TempData["Error"]</div>
        </div>
    }

    <!-- ── PRODUCTO MAIN ── -->
    <div class="product-main">

        <!-- Imagen -->
        <div class="prod-img-panel">
            <img src="@imgUrl" alt="@Model.Nombre"
                 onerror="this.onerror=null;this.src='@imgUrl';" />
            @if (Model.PorcentajeDescuento > 0)
            {
                <div class="prod-badge-discount">-@Model.PorcentajeDescuento%</div>
            }
            @if (stockTotal == 0)
            {
                <div class="prod-badge-agotado">Agotado</div>
            }
        </div>

        <!-- Info -->
        <div class="prod-info-panel">

            <!-- Categoría y género -->
            <div class="prod-category">@(Model.Categoria?.Nombre ?? "Producto") — @(Model.Genero ?? "Universal")</div>

            <!-- Título -->
            <h1 class="prod-title">@Model.Nombre</h1>

            <!-- Descripción -->
            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <p class="prod-desc">@Model.Descripcion</p>
            }

            <!-- Precio -->
            <div class="price-block">
                @if (Model.PorcentajeDescuento > 0)
                {
                    <span class="price-orig">$@Model.PrecioOriginal.ToString("N2")</span>
                    <span class="price-final">$@precioFinal.ToString("N2")</span>
                    <span class="price-discount-tag">-@Model.PorcentajeDescuento% off</span>
                }
                else
                {
                    <span class="price-final">$@precioFinal.ToString("N2")</span>
                }
            </div>

            @if (stockTotal > 0)
            {
                <!-- Selector Talla + Color + Cantidad -->
                <form id="add-cart-form" asp-controller="Carrito" asp-action="Agregar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductoVarianteId" id="variante-id-input" value="" />
                    <input type="hidden" name="returnUrl" value="/Producto/Detalle/@Model.Id" />

                    <div class="variants-section">
                        <!-- Tallas -->
                        <div>
                            <div class="variants-label">Talla <span id="talla-selected-label">—</span></div>
                            <div class="tallas-grid" id="tallas-container">
                                @{
                                    var tallasUnicas = Model.Variantes
                                        .Where(v => v.Stock > 0)
                                        .Select(v => v.Talla)
                                        .Distinct()
                                        .OrderBy(t => t)
                                        .ToList();
                                }
                                @foreach (var talla in tallasUnicas)
                                {
                                    <button type="button" class="talla-btn" data-talla="@talla" onclick="seleccionarTalla(this)">@talla</button>
                                }
                            </div>
                        </div>

                        <!-- Colores (se muestran al seleccionar talla) -->
                        <div id="color-section" style="display:none">
                            <div class="variants-label">Color <span id="color-selected-label">—</span></div>
                            <div class="color-blocks" id="colores-container"></div>
                        </div>

                        <!-- Cantidad -->
                        <div id="qty-section" style="display:none">
                            <div class="variants-label" style="margin-bottom:0.6rem">Cantidad</div>
                            <div class="qty-block">
                                <div class="qty-control">
                                    <button type="button" class="qty-btn" onclick="cambiarCantidad(-1)">−</button>
                                    <input type="number" id="qty-input" name="Cantidad" value="1" min="1" max="99" readonly />
                                    <button type="button" class="qty-btn" onclick="cambiarCantidad(1)">+</button>
                                </div>
                                <div class="stock-info" id="stock-info-text">— uds. disponibles</div>
                            </div>
                        </div>
                    </div>

                    @if (!isSignedIn)
                    {
                        <!-- Aviso: requiere login -->
                        <div class="login-notice" style="margin-top:0.5rem">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <p>Por ley, necesitas una cuenta para comprar. <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Producto/Detalle/@Model.Id">Iniciar sesión</a> o <a asp-controller="Account" asp-action="Register">Registrarse gratis</a>.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Producto/Detalle/@Model.Id" class="btn-login-required" style="margin-top:1rem">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                <polyline points="10 17 15 12 10 7"/>
                                <line x1="15" y1="12" x2="3" y2="12"/>
                            </svg>
                            Iniciar sesión para comprar
                        </a>
                    }
                    else
                    {
                        <button type="submit" class="btn-add-cart" id="btn-agregar" disabled style="margin-top:0.5rem">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                            Selecciona talla y color
                        </button>
                    }
                </form>
            }
            else
            {
                <div style="padding:1rem 1.2rem; background:rgba(224,90,90,0.08); border:1px solid rgba(224,90,90,0.25); border-radius:2px; font-size:0.85rem; color:var(--danger)">
                    Este producto está agotado. Próximamente disponible.
                </div>
            }

            <!-- Especificaciones -->
            <div class="meta-list">
                <div class="meta-row">
                    <span class="meta-key">Categoría</span>
                    <span class="meta-val">@(Model.Categoria?.Nombre ?? "—")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-key">Género</span>
                    <span class="meta-val">@(Model.Genero ?? "Universal")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-key">Stock total</span>
                    <span class="meta-val" style="color:@(stockTotal > 0 ? "var(--success)" : "var(--danger)")">@stockTotal unidades</span>
                </div>
                @if (Model.OfertaFin.HasValue)
                {
                    <div class="meta-row">
                        <span class="meta-key">Oferta hasta</span>
                        <span class="meta-val" style="color:var(--gold)">@Model.OfertaFin.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>

        </div><!-- /prod-info-panel -->
    </div><!-- /product-main -->

    <script>
        // Mapa de variantes del servidor
        const variantes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Variantes.Where(v => v.Stock > 0).Select(v => new {
                id = v.Id,
                talla = v.Talla,
                color = v.Color ?? "Único",
                stock = v.Stock
            })
        ));

        let tallaSel = null;
        let colorSel = null;
        let maxStock = 0;

        function colorToCss(nombre) {
            const map = {
                'negro':'#222','black':'#222','blanco':'#f0f0f0','white':'#f0f0f0',
                'rojo':'#c0392b','red':'#c0392b','azul':'#2980b9','blue':'#2980b9',
                'café':'#6d4c2a','brown':'#6d4c2a','gris':'#7f8c8d','gray':'#7f8c8d','grey':'#7f8c8d',
                'beige':'#d2b48c','verde':'#27ae60','green':'#27ae60',
                'amarillo':'#f1c40f','yellow':'#f1c40f','naranja':'#e67e22','orange':'#e67e22',
                'morado':'#8e44ad','purple':'#8e44ad','rosa':'#e91e8c','pink':'#e91e8c',
                'dorado':'#c9a96e','gold':'#c9a96e','único':'#666','unico':'#666'
            };
            return map[(nombre||'').toLowerCase()] || '#555';
        }

        function seleccionarTalla(btn) {
            document.querySelectorAll('.talla-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            tallaSel = btn.getAttribute('data-talla');
            colorSel = null;
            document.getElementById('talla-selected-label').textContent = tallaSel;
            document.getElementById('variante-id-input').value = '';

            // Rellenar colores para esta talla
            const coloresContainer = document.getElementById('colores-container');
            coloresContainer.innerHTML = '';
            const coloresParaTalla = variantes.filter(v => v.talla === tallaSel);
            coloresContainer.innerHTML = '';
            coloresParaTalla.forEach(v => {
                const btn2 = document.createElement('button');
                btn2.type = 'button';
                btn2.className = 'color-block-btn';
                btn2.setAttribute('data-variante-id', v.id);
                btn2.setAttribute('data-color', v.color);
                btn2.setAttribute('data-stock', v.stock);
                btn2.innerHTML = `<span class="color-dot-sm" style="background:${colorToCss(v.color)}"></span>${v.color}`;
                btn2.onclick = () => seleccionarColor(btn2);
                coloresContainer.appendChild(btn2);
            });

            document.getElementById('color-section').style.display = 'block';
            document.getElementById('color-selected-label').textContent = '—';
            document.getElementById('qty-section').style.display = 'none';
            actualizarBotonAgregar();
        }

        function seleccionarColor(btn) {
            document.querySelectorAll('.color-block-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            colorSel = btn.getAttribute('data-color');
            const varianteId = btn.getAttribute('data-variante-id');
            maxStock = parseInt(btn.getAttribute('data-stock'));

            document.getElementById('color-selected-label').textContent = colorSel;
            document.getElementById('variante-id-input').value = varianteId;

            // Mostrar cantidad
            document.getElementById('qty-section').style.display = 'block';
            document.getElementById('qty-input').max = maxStock;
            document.getElementById('qty-input').value = 1;
            document.getElementById('stock-info-text').textContent = maxStock + ' uds. disponibles';

            actualizarBotonAgregar();
        }

        function cambiarCantidad(delta) {
            const input = document.getElementById('qty-input');
            const current = parseInt(input.value) || 1;
            const newVal = Math.max(1, Math.min(maxStock, current + delta));
            input.value = newVal;
        }

        function actualizarBotonAgregar() {
            const btn = document.getElementById('btn-agregar');
            if (!btn) return;
            if (tallaSel && colorSel) {
                btn.disabled = false;
                btn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Agregar al carrito`;
            } else {
                btn.disabled = true;
                btn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Selecciona talla y color`;
            }
        }

        // Si solo hay un color por variante (Único), auto-seleccionarlo al elegir talla
        // (UX mejorada)
        document.addEventListener('DOMContentLoaded', () => {
            // Auto-seleccionar si solo hay una talla
            const tallasBtns = document.querySelectorAll('.talla-btn');
            if (tallasBtns.length === 1) {
                seleccionarTalla(tallasBtns[0]);
            }
        });
    </script>
</body>
</html>
