@model IEnumerable<Ecommerce.Datos.Entity.Pedido>
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
    ViewData["Title"] = "Mis Pedidos";
    Layout = null; 
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis Pedidos — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        
        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }

        body { background: var(--secondary); color: var(--primary); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }

        /* HEADER / NAV */
        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }
        .nav-actions { display: flex; align-items: center; gap: 1rem; }
        
        .btn-outline {
            padding: 0.6rem 1.5rem; border: 1px solid var(--primary); border-radius: 9999px;
            color: var(--primary); text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.3s ease; background: transparent; cursor: pointer; display: inline-block;
        }
        .btn-outline:hover { background: var(--primary); color: var(--secondary); }
        .btn-filled {
            padding: 0.6rem 2.5rem; border: 1px solid var(--accent); border-radius: 9999px;
            background: var(--accent); color: var(--secondary); text-decoration: none; 
            font-size: 0.95rem; font-weight: 600; transition: all 0.3s ease; cursor: pointer; display: inline-block;
        }
        .btn-filled:hover { background: #e56000; border-color: #e56000; transform: translateY(-2px); }

        /* PAGE HEADER */
        .page-container {
            flex: 1; padding: calc(var(--nav-h) + 40px) 40px 80px; max-width: 1000px; margin: 0 auto; width: 100%;
        }
        .page-title { font-size: 2.5rem; font-weight: 700; margin-bottom: 40px; letter-spacing: -0.02em; }

        .orders-container {
            position: relative; z-index: 1; width: 100%; flex: 1; display: flex; flex-direction: column; gap: 30px;
        }

        .order-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
            overflow: hidden; animation: fadeUp 0.5s ease both;
        }

        .order-header {
            background: rgba(0,0,0,0.02); border-bottom: 1px solid var(--border);
            padding: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;
        }
        .order-header-col { display: flex; flex-direction: column; gap: 5px; }
        .order-meta-lbl { font-size: 0.8rem; text-transform: uppercase; font-weight: 600; color: #666; letter-spacing: 0.05em; }
        .order-meta-val { font-size: 1rem; font-weight: 500; color: var(--primary); }
        .order-total-val { font-size: 1.25rem; font-weight: 700; color: var(--primary); }

        .order-status {
            display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 1rem; border-radius: 9999px; 
            font-size: 0.8rem; font-weight: 600; text-transform: uppercase; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9;
        }

        .order-items { padding: 20px; display: flex; flex-direction: column; gap: 20px; }
        .order-item {
            display: flex; gap: 20px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--border);
        }
        .order-item:last-child { border-bottom: none; padding-bottom: 0; }
        
        .item-img { width: 90px; height: 90px; object-fit: cover; border-radius: 8px; background: #eee; flex-shrink: 0; }
        .item-info { flex: 1; display: flex; flex-direction: column; gap: 5px; }
        .item-name { font-size: 1.15rem; font-weight: 600; color: var(--primary); }
        .item-meta { font-size: 0.9rem; color: #555; display: flex; gap: 15px; }
        .item-price { font-size: 1.1rem; font-weight: 600; }

        .empty-state { text-align: center; padding: 60px 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }
        .empty-state h3 { font-size: 2rem; font-weight: 700; margin-bottom: 15px; }
        .empty-state p { color: #555; margin-bottom: 30px; font-size: 1.1rem; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 768px) {
            header { padding: 0 20px; }
            .page-container { padding: calc(var(--nav-h) + 20px) 20px 40px; }
            .order-header { flex-direction: column; align-items: flex-start; gap: 15px; }
            .order-status { align-self: flex-start; margin-top: 5px; }
            .item-img { width: 70px; height: 70px; }
            .order-item { flex-direction: column; align-items: flex-start; gap: 15px; }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <div class="nav-actions">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-controller="Account" asp-action="Perfil" class="btn-outline" style="border:none;">Perfil</a>
                <a asp-controller="Carrito" asp-action="Index" class="btn-filled">Carrito</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="btn-outline">Salir</button>
                </form>
            }
        </div>
    </header>

    <div class="page-container">
        <h1 class="page-title">Historial de Pedidos</h1>

        <div class="orders-container">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <h3>Aún no tienes pedidos</h3>
                    <p>Empieza a explorar nuestra colección de temporada y descubre tu nuevo estilo.</p>
                    <a href="/#productos" class="btn-filled">Explorar Colección</a>
                </div>
            }
            else
            {
                int delay = 0;
                foreach (var pedido in Model)
                {
                    <div class="order-card" style="animation-delay:@(delay * 0.1)s">
                        <div class="order-header">
                            <div class="order-header-col">
                                <span class="order-meta-lbl">Pedido ID</span>
                                <span class="order-meta-val">#@pedido.Id</span>
                            </div>
                            <div class="order-header-col">
                                <span class="order-meta-lbl">Fecha de Pedido</span>
                                <span class="order-meta-val">@pedido.FechaPedido.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="order-header-col">
                                <span class="order-meta-lbl">Método de Envío</span>
                                <span class="order-meta-val">@(pedido.MetodoEnvio?.Nombre ?? "Estándar")</span>
                            </div>
                            <div class="order-header-col">
                                <span class="order-meta-lbl">Total Neto</span>
                                <span class="order-total-val">$@pedido.Total.ToString("N2")</span>
                            </div>
                            <div class="order-status">
                                @(pedido.Estado == 0 ? "Pedido Pagado y Completado" : "Procesando")
                            </div>
                        </div>

                        <div class="order-items">
                            @foreach (var det in pedido.Detalles)
                            {
                                var prod = det.ProductoVariante.Producto;
                                var imgSrc = string.IsNullOrEmpty(prod.ImagenUrl) 
                                    ? "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=150&auto=format&fit=crop" 
                                    : prod.ImagenUrl;

                                <div class="order-item">
                                    <img src="@imgSrc" class="item-img" alt="@prod.Nombre" onerror="this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=150&auto=format&fit=crop';" />
                                    <div class="item-info">
                                        <h4 class="item-name">@prod.Nombre</h4>
                                        <div class="item-meta">
                                            <span>Talla: <strong>@det.ProductoVariante.Talla</strong></span>
                                            @if (det.ProductoVariante.Color != null && det.ProductoVariante.Color != "Único")
                                            {
                                                <span>Color: <strong>@det.ProductoVariante.Color</strong></span>
                                            }
                                            <span>Cantidades: <strong>@det.Cantidad un.</strong></span>
                                        </div>
                                    </div>
                                    <div class="item-price">$@((det.PrecioUnitarioPagado * det.Cantidad).ToString("N2"))</div>
                                </div>
                            }
                        </div>
                    </div>
                    delay += 1;
                }
            }
        </div>
    </div>
</body>
</html>
