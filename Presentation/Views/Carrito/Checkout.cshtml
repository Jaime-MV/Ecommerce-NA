@model Ecommerce.Presentacion.Models.ViewModels.CarritoViewModel
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject UserManager<Usuario> UserManager
@{
    ViewData["Title"] = "Finalizar compra";
    Layout = null;
    var metodosEnvio = ViewBag.MetodosEnvio as List<MetodoEnvio> ?? new List<MetodoEnvio>();
    var direcciones = ViewBag.Direcciones as List<DireccionUsuario> ?? new List<DireccionUsuario>();
    var direccionPrincipal = direcciones.FirstOrDefault(d => d.EsPrincipal) ?? direcciones.FirstOrDefault();
    string direccionValorInicial = direccionPrincipal != null ? $"{direccionPrincipal.DireccionCompleta}, {direccionPrincipal.Ciudad}" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Finalizar Compra — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }
        body { background: var(--secondary); color: var(--primary); -webkit-font-smoothing: antialiased; }

        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h); display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }
        .nav-back { font-size: 0.95rem; font-weight: 500; color: #666; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s; }
        .nav-back:hover { color: var(--accent); }

        .checkout-wrap {
            display: grid; grid-template-columns: 1fr 450px; min-height: 100vh; padding-top: var(--nav-h);
        }

        .checkout-form-panel { padding: 40px; }
        .checkout-summary { padding: 40px; background: var(--surface); border-left: 1px solid var(--border); }

        .section-title { font-size: 2rem; font-weight: 700; color: var(--primary); margin-bottom: 30px; letter-spacing: -0.02em; }
        .section-sub-title { font-size: 1.25rem; font-weight: 600; color: var(--primary); margin: 30px 0 15px; }

        .form-group { margin-bottom: 20px; }
        .form-label { display: block; font-size: 0.9rem; font-weight: 600; color: #444; margin-bottom: 8px; }
        .form-input {
            width: 100%; padding: 12px 15px; background: var(--secondary); border: 1px solid var(--border);
            color: var(--primary); font-family: 'Inter', sans-serif; font-size: 1rem; border-radius: 8px; outline: none; transition: border-color 0.2s;
        }
        .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(255,107,0,0.1); }

        /* Direcciones & Envio Options */
        .option-list { display: flex; flex-direction: column; gap: 15px; }
        .option-card {
            display: flex; align-items: flex-start; gap: 1rem; padding: 15px; background: var(--secondary);
            border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all 0.2s;
        }
        .option-card:has(input:checked) { border-color: var(--primary); background: #fafafa; }
        .option-card input[type="radio"] { margin-top: 4px; accent-color: var(--primary); width: 18px; height: 18px; cursor: pointer; }
        .option-info { flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .option-name { font-size: 1rem; font-weight: 600; color: var(--primary); }
        .option-desc { font-size: 0.95rem; color: #666; }
        .option-meta { font-size: 1.1rem; font-weight: 600; color: var(--primary); }

        .address-actions { margin-top: 10px; display: none; }
        .option-card:has(input:checked) .address-actions { display: block; }
        .badge-primary { background: #e8f5e9; color: #2e7d32; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin-left: 10px; }
        .btn-set-primary { padding: 6px 14px; background: transparent; border: 1px solid var(--primary); color: var(--primary); border-radius: 9999px; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .btn-set-primary:hover { background: var(--primary); color: var(--secondary); }

        .btn-confirm {
            display: flex; align-items: center; justify-content: center; width: 100%; padding: 1.2rem;
            background: var(--accent); color: var(--secondary); border: none; border-radius: 9999px; font-family: 'Inter', sans-serif;
            font-size: 1rem; font-weight: 600; cursor: pointer; margin-top: 40px; transition: all 0.3s ease;
        }
        .btn-confirm:hover { background: #e56000; transform: translateY(-2px); }
        .btn-confirm:disabled { background: var(--border); color: #999; cursor: not-allowed; transform: none; }

        /* Summary Panel */
        .summary-title { font-size: 1.5rem; font-weight: 700; color: var(--primary); margin-bottom: 25px; }
        .sum-item { display: flex; gap: 15px; align-items: center; margin-bottom: 20px; }
        .sum-item-img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); }
        .sum-item-info { flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .sum-item-name { font-size: 0.95rem; font-weight: 600; color: var(--primary); }
        .sum-item-meta { font-size: 0.85rem; color: #666; }
        .sum-item-price { font-size: 1rem; font-weight: 600; color: var(--primary); }
        
        .divider { height: 1px; background: var(--border); margin: 25px 0; }
        .sum-row { display: flex; justify-content: space-between; font-size: 1rem; margin-bottom: 12px; color: #555; }
        .sum-row .amt { font-weight: 600; color: var(--primary); }
        .sum-total { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 20px; border-top: 1px solid var(--border); }
        .sum-total .lbl { font-size: 1.1rem; font-weight: 600; color: var(--primary); }
        .sum-total .amt { font-size: 2rem; font-weight: 700; color: var(--accent); }

        .alert-box { padding: 1rem 1.5rem; border-radius: 8px; font-weight: 500; margin-bottom: 20px; }
        .alert-box.error { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }

        @@media (max-width: 900px) {
            .checkout-wrap { grid-template-columns: 1fr; }
            .checkout-form-panel { padding: 40px 20px; }
            .checkout-summary { padding: 40px 20px; border-left: none; border-top: 1px solid var(--border); order: -1; }
            header { padding: 0 20px; }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <a asp-controller="Carrito" asp-action="Index" class="nav-back">Volver al carrito</a>
    </header>

    <div class="checkout-wrap">
        <div class="checkout-form-panel">
            @if (TempData["Error"] != null)
            {
                <div class="alert-box error">✕ @TempData["Error"]</div>
            }

            <h1 class="section-title">Finalizar Compra</h1>

            <!-- Seleccion de Direccion y Metodo de pago -->
            <form asp-controller="Carrito" asp-action="ConfirmarPedido" method="post" id="checkout-form">
                @Html.AntiForgeryToken()
                
                <div class="section-sub-title">Dirección de envío</div>
                
                @if (direcciones.Any())
                {
                    <div class="option-list">
                        @foreach(var dir in direcciones)
                        {
                            var dirStr = $"{dir.DireccionCompleta}, {dir.Ciudad}";
                            <label class="option-card">
                                <input type="radio" name="direccionRadio" value="@dirStr" @(dir.EsPrincipal ? "checked" : "") onchange="document.getElementById('direccion').value = this.value; document.querySelectorAll('.address-actions').forEach(el=>el.style.display='none'); document.getElementById('actions-dir-@dir.Id').style.display='block';" />
                                <div class="option-info">
                                    <div class="option-name">
                                        @dir.NombreContacto
                                        @if(dir.EsPrincipal) { <span class="badge-primary">Principal</span> }
                                    </div>
                                    <div class="option-desc">@dirStr</div>
                                    
                                    <div class="address-actions" id="actions-dir-@dir.Id" style="@(dir.EsPrincipal ? "display:block;" : "display:none;")">
                                        @if(!dir.EsPrincipal)
                                        {
                                            <!-- Boton que hace post independiente sin enviar el checkout previniendo default en form -->
                                            <button type="submit" form="form-set-primary-@dir.Id" class="btn-set-primary">Definir como principal</button>
                                        }
                                        else 
                                        {
                                            <span style="font-size:0.85rem;color:#666;">Se utilizará esta dirección.</span>
                                        }
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                    <input type="hidden" name="direccion" id="direccion" value="@direccionValorInicial" />
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label" for="direccion">Dirección completa</label>
                        <textarea class="form-input" name="direccion" id="direccion" rows="3" placeholder="Calle, número, colonia, ciudad, estado, CP..." required></textarea>
                    </div>
                }

                <div class="section-sub-title">Método de envío</div>
                @if (metodosEnvio.Any())
                {
                    <div class="option-list">
                        @foreach (var metodo in metodosEnvio)
                        {
                            <label class="option-card">
                                <input type="radio" name="metodoEnvioId" value="@metodo.Id"
                                       data-costo="@metodo.Costo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                       onchange="actualizarTotal(this)"
                                       @(metodosEnvio.IndexOf(metodo) == 0 ? "checked" : "") />
                                <div class="option-info">
                                    <div class="option-name">@metodo.Nombre</div>
                                    @if (!string.IsNullOrEmpty(metodo.TiempoEstimado))
                                    {
                                        <div class="option-desc">@metodo.TiempoEstimado</div>
                                    }
                                </div>
                                <div class="option-meta">$@metodo.Costo.ToString("N2")</div>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <p style="font-size:0.95rem;color:#666">No hay métodos de envío disponibles.</p>
                    <input type="hidden" name="metodoEnvioId" value="0" />
                }

                <button type="submit" class="btn-confirm" @(metodosEnvio.Any() ? "" : "disabled")>
                    Confirmar y Pagar
                </button>
            </form>

            <!-- Formularios ocultos para redefinir principal -->
            @foreach(var dir in direcciones.Where(d => !d.EsPrincipal))
            {
                <form asp-controller="Account" asp-action="EstablecerDireccionPrincipal" method="post" id="form-set-primary-@dir.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@dir.Id" />
                    <input type="hidden" name="returnUrl" value="/Carrito/Checkout" />
                </form>
            }

        </div>

        <div class="checkout-summary">
            <h2 class="summary-title">Resumen de Compra</h2>
            <div class="summary-items">
                @foreach (var item in Model.Items)
                {
                    var imgSrc = string.IsNullOrEmpty(item.ImagenUrl)
                        ? "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=150&auto=format&fit=crop"
                        : item.ImagenUrl;
                    <div class="sum-item">
                        <img class="sum-item-img" src="@imgSrc" alt="@item.ProductoNombre" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=150&auto=format&fit=crop';" />
                        <div class="sum-item-info">
                            <div class="sum-item-name">@item.ProductoNombre</div>
                            <div class="sum-item-meta">Talla @item.Talla @(item.Color != null && item.Color != "Único" ? "| " + item.Color : "") × @item.Cantidad</div>
                        </div>
                        <div class="sum-item-price">$@item.Subtotal.ToString("N2")</div>
                    </div>
                }
            </div>
            
            <div class="divider"></div>
            
            <div class="sum-row"><span>Subtotal</span><span class="amt">$@Model.Subtotal.ToString("N2")</span></div>
            <div class="sum-row"><span>Costo de Envío</span><span class="amt" id="envio-display">
                @if (metodosEnvio.Any())
                {
                    @:$@metodosEnvio[0].Costo.ToString("N2")
                }
                else
                {
                    @:—
                }
            </span></div>
            
            <div class="sum-total">
                <span class="lbl">Total</span>
                <span class="amt" id="total-display">
                    @if (metodosEnvio.Any())
                    {
                        @:$@((Model.Subtotal + metodosEnvio[0].Costo).ToString("N2"))
                    }
                    else
                    {
                        @:$@Model.Subtotal.ToString("N2")
                    }
                </span>
            </div>
        </div>
    </div>

    <script>
        const subtotal = @Model.Subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

        function actualizarTotal(radio) {
            const costo = parseFloat(radio.getAttribute('data-costo')) || 0;
            const total = subtotal + costo;
            document.getElementById('envio-display').textContent = '$' + costo.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            document.getElementById('total-display').textContent = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        const firstRadio = document.querySelector('input[name="metodoEnvioId"]:checked');
        if (firstRadio) actualizarTotal(firstRadio);

        // Previne enter form dev
        document.getElementById('checkout-form').addEventListener('keydown', function(event) {
            if(event.key === 'Enter' && event.target.tagName !== 'TEXTAREA') {
                event.preventDefault();
            }
        });
    </script>
</body>
</html>
