@model Ecommerce.Presentacion.Models.ViewModels.CarritoViewModel
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
    ViewData["Title"] = "Mi Carrito";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Carrito — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        
        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }

        body { background: var(--secondary); color: var(--primary); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }

        /* HEADER / NAV */
        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }
        .nav-actions { display: flex; align-items: center; gap: 1rem; }
        
        .btn-outline {
            padding: 0.6rem 1.5rem; border: 1px solid var(--primary); border-radius: 9999px;
            color: var(--primary); text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.3s ease; background: transparent; cursor: pointer;
        }
        .btn-outline:hover { background: var(--primary); color: var(--secondary); }
        .btn-filled {
            padding: 0.6rem 1.5rem; border: 1px solid var(--accent); border-radius: 9999px;
            background: var(--accent); color: var(--secondary); text-decoration: none; 
            font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease; cursor: pointer;
        }
        .btn-filled:hover { background: #e56000; border-color: #e56000; transform: translateY(-2px); }

        /* CART LAYOUT */
        .page-container {
            flex: 1; padding: calc(var(--nav-h) + 40px) 40px 80px; max-width: 1400px; margin: 0 auto; width: 100%;
        }
        .page-title { font-size: 2.5rem; font-weight: 700; margin-bottom: 40px; letter-spacing: -0.02em; }

        .cart-layout {
            display: grid; grid-template-columns: 1fr 380px; gap: 40px;
        }

        /* ITEMS */
        .cart-items-panel { display: flex; flex-direction: column; gap: 20px; }
        .cart-item {
            display: grid; grid-template-columns: 120px 1fr auto; gap: 20px;
            padding: 20px; border: 1px solid var(--border); border-radius: 12px;
            background: var(--secondary); align-items: center;
        }
        .cart-item-img {
            width: 120px; height: 120px; object-fit: cover; border-radius: 8px; background: var(--surface);
        }
        .cart-item-info { display: flex; flex-direction: column; gap: 0.5rem; }
        .cart-item-name { font-size: 1.25rem; font-weight: 600; color: var(--primary); text-decoration: none; }
        .cart-item-meta { font-size: 0.95rem; color: #666; display: flex; gap: 1rem; }
        .cart-item-price { font-size: 1.1rem; font-weight: 600; }

        /* QTY CONTROLS */
        .cart-item-qty {
            display: flex; align-items: center; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; width: fit-content; margin-top: 10px;
        }
        .qty-adj-btn {
            width: 36px; height: 36px; background: var(--surface); border: none; font-size: 1.2rem; cursor: pointer; transition: background 0.2s;
        }
        .qty-adj-btn:hover { background: #e0e0e0; }
        .qty-display {
            width: 48px; height: 36px; display: flex; align-items: center; justify-content: center;
            font-weight: 600; border-left: 1px solid var(--border); border-right: 1px solid var(--border);
        }

        .cart-item-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 15px; }
        .item-subtotal { font-size: 1.5rem; font-weight: 700; color: var(--primary); }
        .btn-remove {
            background: transparent; border: none; cursor: pointer; color: #ff4444;
            font-size: 0.9rem; font-weight: 500; text-decoration: underline; transition: opacity 0.2s;
        }
        .btn-remove:hover { opacity: 0.7; }

        /* SUMMARY panel */
        .cart-summary-panel {
            background: var(--surface); padding: 30px; border-radius: 12px; border: 1px solid var(--border); height: fit-content; position: sticky; top: calc(var(--nav-h) + 40px);
        }
        .summary-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 25px; }
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 1.05rem; }
        .summary-total {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 1.2rem; font-weight: 700;
        }
        .summary-total .val { font-size: 2rem; color: var(--accent); }

        .btn-checkout { display: block; text-align: center; width: 100%; margin-top: 30px; padding: 1rem; font-size: 1rem; }
        .btn-continue-shopping { display: block; text-align: center; width: 100%; margin-top: 15px; padding: 1rem; font-size: 1rem; border: 1px solid var(--border); border-radius: 9999px; text-decoration: none; color: var(--primary); font-weight: 600; transition: background 0.2s; }
        .btn-continue-shopping:hover { background: var(--border); }

        /* Alert Box */
        .alert-box { padding: 15px 20px; border-radius: 8px; font-weight: 500; margin-bottom: 20px; }
        .alert-box.success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .alert-box.error { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }

        /* Empty state */
        .empty-cart { text-align: center; padding: 60px 20px; background: var(--surface); border-radius: 12px; border: 1px solid var(--border); grid-column: 1 / -1; }
        .empty-cart h2 { font-size: 2rem; font-weight: 700; margin-bottom: 15px; }
        .empty-cart p { color: #555; margin-bottom: 30px; font-size: 1.1rem; }
        
        @@media (max-width: 900px) {
            .cart-layout { grid-template-columns: 1fr; }
            .cart-summary-panel { position: static; }
        }
        @@media (max-width: 600px) {
            header { padding: 0 20px; }
            .page-container { padding: calc(var(--nav-h) + 20px) 20px 40px; }
            .cart-item { grid-template-columns: 80px 1fr; }
            .cart-item-actions { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: center; }
            .cart-item-img { width: 80px; height: 80px; }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <div class="nav-actions">
            @if (SignInManager.IsSignedIn(User))
            {
                <a asp-controller="Account" asp-action="Perfil" class="btn-outline" style="border:none;">Perfil</a>
                <a asp-controller="Account" asp-action="MisPedidos" class="btn-outline" style="border:none;">Mis pedidos</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" class="btn-outline">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-outline" style="border:none;">Iniciar Sesión</a>
            }
        </div>
    </header>

    <div class="page-container">
        <h1 class="page-title">Mi Carrito</h1>

        @if (TempData["Exito"] != null)
        {
            <div class="alert-box success">✓ @TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-box error">✕ @TempData["Error"]</div>
        }

        <div class="cart-layout">
            @if (!Model.Items.Any())
            {
                <div class="empty-cart">
                    <h2>Tu carrito está vacío</h2>
                    <p>Agrega productos desde nuestro catálogo para iniciar tu compra.</p>
                    <a href="/#productos" class="btn-filled" style="display:inline-block; width:auto; padding: 0.8rem 2rem;">Ver Catálogo</a>
                </div>
            }
            else
            {
                <!-- ITEMS LIST -->
                <div class="cart-items-panel">
                    @foreach (var item in Model.Items)
                    {
                         var imgSrc = string.IsNullOrEmpty(item.ImagenUrl)
                            ? "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=300&auto=format&fit=crop"
                            : item.ImagenUrl;

                        <div class="cart-item">
                            <img class="cart-item-img" src="@imgSrc" alt="@item.ProductoNombre" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=300&auto=format&fit=crop';" />
                            
                            <div class="cart-item-info">
                                <a href="/Producto/Detalle/@item.ProductoId" class="cart-item-name">@item.ProductoNombre</a>
                                <div class="cart-item-meta">
                                    <span>Talla: <strong>@item.Talla</strong></span>
                                    @if (!string.IsNullOrEmpty(item.Color) && item.Color != "Único")
                                    {
                                        <span>Color: <strong>@item.Color</strong></span>
                                    }
                                </div>
                                <div class="cart-item-price">$@item.PrecioUnitario.ToString("N2") c/u</div>
                                
                                <form asp-controller="Carrito" asp-action="Actualizar" method="post" style="margin-top: 5px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CarritoDetalleId" value="@item.CarritoDetalleId" />
                                    <div class="cart-item-qty">
                                        <button type="button" class="qty-adj-btn" onclick="adjQty(this,-1,@item.CarritoDetalleId)">−</button>
                                        <span class="qty-display" id="qty-@item.CarritoDetalleId">@item.Cantidad</span>
                                        <button type="button" class="qty-adj-btn" onclick="adjQty(this,1,@item.CarritoDetalleId)">+</button>
                                        <input type="hidden" name="Cantidad" id="qty-hidden-@item.CarritoDetalleId" value="@item.Cantidad" />
                                    </div>
                                    <button type="submit" style="display:none" id="submit-@item.CarritoDetalleId">actualizar</button>
                                </form>
                            </div>

                            <div class="cart-item-actions">
                                <div class="item-subtotal">$@item.Subtotal.ToString("N2")</div>
                                <form asp-controller="Carrito" asp-action="Eliminar" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="carritoDetalleId" value="@item.CarritoDetalleId" />
                                    <button type="submit" class="btn-remove" onclick="return confirm('¿Eliminar este producto?')">Eliminar</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <!-- SUMMARY -->
                <div class="cart-summary-panel">
                    <h3 class="summary-title">Resumen de Compra</h3>
                    
                    <div class="summary-row">
                        <span>Subtotal (@Model.TotalItems productos)</span>
                        <strong>$@Model.Subtotal.ToString("N2")</strong>
                    </div>
                    <div class="summary-row" style="color: #2e7d32; font-weight: 500;">
                        <span>Envío estimado</span>
                        <span>Se calcula en el pago</span>
                    </div>

                    <div class="summary-total">
                        <span>Total:</span>
                        <span class="val">$@Model.Subtotal.ToString("N2")</span>
                    </div>

                    <a asp-controller="Carrito" asp-action="Checkout" class="btn-filled btn-checkout">Proceder al Pago</a>
                    <a href="/#productos" class="btn-continue-shopping">Seguir Comprando</a>
                </div>
            }
        </div>
    </div>

    <script>
        const stockMap = {
            @foreach (var item in Model.Items)
            {
                @:@item.CarritoDetalleId: @item.StockDisponible,
            }
        };

        function adjQty(btn, delta, detalleId) {
            const display = document.getElementById('qty-' + detalleId);
            const hidden = document.getElementById('qty-hidden-' + detalleId);
            const maxStock = stockMap[detalleId] || 99;
            let current = parseInt(display.textContent) || 1;
            let newVal = Math.max(1, Math.min(maxStock, current + delta));
            display.textContent = newVal;
            hidden.value = newVal;
            clearTimeout(btn._timer);
            btn._timer = setTimeout(() => {
                document.getElementById('submit-' + detalleId).click();
            }, 700);
        }
    </script>
</body>
</html>
