@model Ecommerce.Presentacion.Models.ViewModels.CarritoViewModel
@using Microsoft.AspNetCore.Identity
@using Ecommerce.Datos.Entity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@{
    ViewData["Title"] = "Mi Carrito";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Carrito — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:#0a0a0b; --surface:#111113; --surface2:#161618;
            --border:rgba(255,255,255,0.08); --gold:#c9a96e; --gold-dim:#8a6d3b;
            --gold-pale:rgba(201,169,110,0.12); --text:#e8e3db; --muted:#6b6560;
            --light:#a09890; --nav-h:70px; --success:#4caf7d; --danger:#e05a5a;
        }
        html { scroll-behavior: smooth; }
        body { background:var(--bg); color:var(--text); font-family:'DM Sans',sans-serif; overflow-x:hidden; }
        body::before {
            content:''; position:fixed; inset:0; z-index:0; pointer-events:none;
            background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
        }

        /* NAV */
        nav {
            position:fixed; top:0; left:0; right:0; z-index:100;
            height:var(--nav-h); display:flex; align-items:center; justify-content:space-between;
            padding:0 3.5rem; background:rgba(10,10,11,0.92); backdrop-filter:blur(20px);
            border-bottom:1px solid var(--border);
        }
        .nav-brand { font-family:'Cormorant Garamond',serif; font-size:1.45rem; font-weight:300; letter-spacing:0.3em; text-transform:uppercase; color:var(--gold); text-decoration:none; }
        .nav-links { display:flex; align-items:center; gap:2rem; list-style:none; }
        .nav-links a { font-size:0.78rem; letter-spacing:0.13em; text-transform:uppercase; color:var(--light); text-decoration:none; transition:color 0.2s; }
        .nav-links a:hover { color:var(--gold); }

        /* PAGE HEADER */
        .page-header {
            position:relative; z-index:1;
            padding:calc(var(--nav-h) + 3.5rem) 3.5rem 2rem;
            border-bottom:1px solid var(--border);
        }
        .page-eyebrow { font-size:0.7rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--gold); margin-bottom:0.8rem; }
        .page-title { font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,3rem); font-weight:300; color:var(--text); }

        /* CART LAYOUT */
        .cart-layout {
            position:relative; z-index:1;
            display:grid;
            grid-template-columns: 1fr 380px;
            gap:0;
            min-height:60vh;
        }

        /* ITEMS */
        .cart-items-panel { padding:2.5rem 3.5rem; border-right:1px solid var(--border); }
        .cart-item {
            display:grid;
            grid-template-columns:100px 1fr auto;
            gap:1.5rem;
            padding:1.8rem 0;
            border-bottom:1px solid var(--border);
            animation: fadeUp 0.4s ease both;
        }
        .cart-item:last-child { border-bottom:none; }
        .cart-item-img {
            width:100px; height:100px;
            object-fit:cover; border-radius:1px;
            background:#1a1810;
        }
        .cart-item-img-placeholder {
            width:100px; height:100px;
            background:#1a1810; border-radius:1px;
            display:flex; align-items:center; justify-content:center;
            color:var(--muted);
        }
        .cart-item-info { display:flex; flex-direction:column; gap:0.4rem; }
        .cart-item-name { font-family:'Cormorant Garamond',serif; font-size:1.15rem; font-weight:400; color:var(--text); }
        .cart-item-meta { font-size:0.78rem; color:var(--muted); display:flex; gap:1rem; flex-wrap:wrap; }
        .cart-item-price { font-size:0.9rem; color:var(--light); }
        .cart-item-price strong { color:var(--gold); font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-weight:300; }

        /* Qty controls inline */
        .cart-item-qty {
            display:flex; align-items:center;
            margin-top:0.6rem;
            border:1px solid var(--border); border-radius:1px;
            overflow:hidden; width:fit-content;
        }
        .qty-adj-btn {
            width:32px; height:32px; background:transparent; border:none;
            color:var(--light); font-size:1rem; cursor:pointer;
            display:flex; align-items:center; justify-content:center;
            transition:background 0.2s, color 0.2s;
        }
        .qty-adj-btn:hover { background:var(--gold-pale); color:var(--gold); }
        .qty-display {
            width:40px; height:32px; font-size:0.85rem;
            display:flex; align-items:center; justify-content:center;
            color:var(--text); background:var(--surface2);
            border-left:1px solid var(--border); border-right:1px solid var(--border);
        }

        .cart-item-actions { display:flex; flex-direction:column; align-items:flex-end; gap:1rem; padding-top:0.2rem; }
        .item-subtotal { font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:300; color:var(--gold); }
        .btn-remove {
            background:transparent; border:none; cursor:pointer;
            color:var(--muted); font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase;
            transition:color 0.2s; padding:0;
        }
        .btn-remove:hover { color:var(--danger); }

        /* SUMMARY PANEL */
        .cart-summary-panel {
            padding:2.5rem;
            background:var(--surface);
            position:sticky; top:var(--nav-h); height:fit-content;
        }
        .summary-title { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:300; color:var(--text); margin-bottom:2rem; }
        .summary-row { display:flex; justify-content:space-between; padding:0.7rem 0; border-bottom:1px solid var(--border); font-size:0.88rem; }
        .summary-row:last-of-type { border-bottom: none; }
        .summary-row .label { color:var(--muted); }
        .summary-row .val { color:var(--text); }
        .summary-total { display:flex; justify-content:space-between; align-items:baseline; padding:1.2rem 0 0; margin-top:0.5rem; border-top:1px solid var(--border); }
        .summary-total .label { font-size:0.82rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted); }
        .summary-total .val { font-family:'Cormorant Garamond',serif; font-size:2rem; font-weight:300; color:var(--gold); }

        .btn-checkout {
            display:flex; align-items:center; justify-content:center; gap:0.7rem;
            width:100%; padding:1rem;
            background:var(--gold); color:var(--bg);
            border:none; border-radius:1px;
            font-family:'DM Sans',sans-serif;
            font-size:0.82rem; font-weight:500; letter-spacing:0.2em; text-transform:uppercase;
            cursor:pointer; margin-top:1.5rem;
            text-decoration:none;
            transition:opacity 0.25s, transform 0.25s;
        }
        .btn-checkout:hover { opacity:0.88; transform:translateY(-1px); }
        .btn-keep-shopping {
            display:flex; align-items:center; justify-content:center; gap:0.5rem;
            width:100%; padding:0.75rem;
            background:transparent; border:1px solid var(--border);
            color:var(--light); border-radius:1px;
            font-size:0.78rem; letter-spacing:0.13em; text-transform:uppercase;
            text-decoration:none; margin-top:0.6rem;
            transition:border-color 0.2s, color 0.2s;
        }
        .btn-keep-shopping:hover { border-color:var(--gold); color:var(--gold); }

        /* Empty state */
        .empty-cart {
            padding:5rem 3.5rem; text-align:center;
            grid-column:1/-1;
        }
        .empty-cart svg { color:var(--gold-dim); opacity:0.35; margin-bottom:1.5rem; }
        .empty-cart h2 { font-family:'Cormorant Garamond',serif; font-size:2.2rem; font-weight:300; color:var(--text); margin-bottom:0.8rem; }
        .empty-cart p { font-size:0.9rem; color:var(--muted); margin-bottom:2.5rem; }
        .btn-go-shop {
            display:inline-flex; align-items:center; gap:0.6rem;
            padding:0.9rem 2.4rem;
            background:var(--gold); color:var(--bg);
            font-size:0.78rem; font-weight:500; letter-spacing:0.18em; text-transform:uppercase;
            text-decoration:none; border-radius:1px;
            transition:opacity 0.25s;
        }
        .btn-go-shop:hover { opacity:0.88; }

        /* Alerts */
        .alert-box { padding:0.85rem 1.2rem; border-radius:2px; font-size:0.85rem; line-height:1.4; }
        .alert-box.success { background:rgba(76,175,125,0.1); border:1px solid rgba(76,175,125,0.3); color:var(--success); }
        .alert-box.error { background:rgba(224,90,90,0.1); border:1px solid rgba(224,90,90,0.3); color:var(--danger); }

        @@keyframes fadeUp {
            from { opacity:0; transform:translateY(16px); }
            to   { opacity:1; transform:translateY(0); }
        }

        @@media (max-width:900px) {
            .cart-layout { grid-template-columns:1fr; }
            .cart-summary-panel { position:static; border-top:1px solid var(--border); }
            nav, .page-header, .cart-items-panel { padding-left:1.5rem; padding-right:1.5rem; }
            .cart-summary-panel { padding:2rem 1.5rem; }
        }
        @@media (max-width:600px) {
            .cart-item { grid-template-columns:72px 1fr; }
            .cart-item-actions { grid-column:1/-1; flex-direction:row; align-items:center; justify-content:space-between; }
            .cart-item-img, .cart-item-img-placeholder { width:72px; height:72px; }
        }
    </style>
</head>
<body>

    <!-- NAV -->
    <nav>
        <a href="/" class="nav-brand">Ecommerce NA</a>
        <ul class="nav-links">
            <li><a href="/#productos">Colección</a></li>
            <li><a asp-controller="Carrito" asp-action="Index" style="color:var(--gold)">
                Carrito (@Model.TotalItems)
            </a></li>
            <li><a asp-controller="Account" asp-action="MisPedidos">Mis Pedidos</a></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" style="background:none;border:none;font-family:'DM Sans',sans-serif;font-size:0.78rem;letter-spacing:0.13em;text-transform:uppercase;cursor:pointer;color:var(--light);">Salir</button>
                </form>
            </li>
        </ul>
    </nav>

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-eyebrow">Tu compra</div>
        <h1 class="page-title">Mi Carrito</h1>
    </div>

    <!-- ALERTS -->
    @if (TempData["Exito"] != null)
    {
        <div style="position:relative;z-index:1;padding:1rem 3.5rem 0">
            <div class="alert-box success">✓ @TempData["Exito"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="position:relative;z-index:1;padding:1rem 3.5rem 0">
            <div class="alert-box error">✕ @TempData["Error"]</div>
        </div>
    }

    <!-- CARRITO LAYOUT -->
    <div class="cart-layout">

        @if (!Model.Items.Any())
        {
            <div class="empty-cart">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="display:block;margin:0 auto">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                <h2>Tu carrito está vacío</h2>
                <p>Agrega productos desde el catálogo para iniciar tu compra.</p>
                <a href="/#productos" class="btn-go-shop">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Ver catálogo
                </a>
            </div>
        }
        else
        {
            <!-- LISTA DE ITEMS -->
            <div class="cart-items-panel">
                @foreach (var item in Model.Items)
                {
                    var imgSrc = string.IsNullOrEmpty(item.ImagenUrl)
                        ? "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=300&auto=format&fit=crop"
                        : item.ImagenUrl;

                    <div class="cart-item">
                        <!-- Imagen -->
                        <img class="cart-item-img"
                             src="@imgSrc"
                             alt="@item.ProductoNombre"
                             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=300&auto=format&fit=crop';" />

                        <!-- Info -->
                        <div class="cart-item-info">
                            <a href="/Producto/Detalle/@item.ProductoId" class="cart-item-name" style="text-decoration:none;color:inherit;transition:color 0.2s;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='inherit'">@item.ProductoNombre</a>
                            <div class="cart-item-meta">
                                <span>Talla: <strong style="color:var(--text)">@item.Talla</strong></span>
                                @if (!string.IsNullOrEmpty(item.Color) && item.Color != "Único")
                                {
                                    <span>Color: <strong style="color:var(--text)">@item.Color</strong></span>
                                }
                            </div>
                            <div class="cart-item-price">
                                <strong>$@item.PrecioUnitario.ToString("N2")</strong> / ud.
                            </div>

                            <!-- Actualizar cantidad -->
                            <form asp-controller="Carrito" asp-action="Actualizar" method="post" style="margin-top:0.5rem">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="CarritoDetalleId" value="@item.CarritoDetalleId" />
                                <div class="cart-item-qty">
                                    <button type="button" class="qty-adj-btn" onclick="adjQty(this,-1,@item.CarritoDetalleId)">−</button>
                                    <span class="qty-display" id="qty-@item.CarritoDetalleId">@item.Cantidad</span>
                                    <button type="button" class="qty-adj-btn" onclick="adjQty(this,1,@item.CarritoDetalleId)">+</button>
                                    <input type="hidden" name="Cantidad" id="qty-hidden-@item.CarritoDetalleId" value="@item.Cantidad" />
                                </div>
                                <button type="submit" style="display:none" id="submit-@item.CarritoDetalleId">actualizar</button>
                            </form>
                        </div>

                        <!-- Subtotal + Eliminar -->
                        <div class="cart-item-actions">
                            <div class="item-subtotal">$@item.Subtotal.ToString("N2")</div>
                            <form asp-controller="Carrito" asp-action="Eliminar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="carritoDetalleId" value="@item.CarritoDetalleId" />
                                <button type="submit" class="btn-remove" onclick="return confirm('¿Eliminar este producto?')">✕ Eliminar</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- RESUMEN -->
            <div class="cart-summary-panel">
                <div class="summary-title">Resumen del pedido</div>

                <div class="summary-row">
                    <span class="label">Productos (@Model.TotalItems uds.)</span>
                    <span class="val">$@Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="summary-row">
                    <span class="label">Envío</span>
                    <span class="val" style="color:var(--success)">Se calcula al proceder</span>
                </div>

                <div class="summary-total">
                    <span class="label">Subtotal</span>
                    <span class="val">$@Model.Subtotal.ToString("N2")</span>
                </div>

                <a asp-controller="Carrito" asp-action="Checkout" class="btn-checkout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                    Proceder al pago
                </a>
                <a href="/#productos" class="btn-keep-shopping">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Seguir comprando
                </a>
            </div>
        }
    </div>

    <script>
        const stockMap = {
            @foreach (var item in Model.Items)
            {
                @:@item.CarritoDetalleId: @item.StockDisponible,
            }
        };

        function adjQty(btn, delta, detalleId) {
            const display = document.getElementById('qty-' + detalleId);
            const hidden = document.getElementById('qty-hidden-' + detalleId);
            const maxStock = stockMap[detalleId] || 99;
            let current = parseInt(display.textContent) || 1;
            let newVal = Math.max(1, Math.min(maxStock, current + delta));
            display.textContent = newVal;
            hidden.value = newVal;
            // Auto-submit after brief delay
            clearTimeout(btn._timer);
            btn._timer = setTimeout(() => {
                document.getElementById('submit-' + detalleId).click();
            }, 700);
        }
    </script>
</body>
</html>
