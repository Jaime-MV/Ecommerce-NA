@model Ecommerce.Datos.Entity.Pedido
@{
    ViewData["Title"] = "Pedido Confirmado";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedido Confirmado — Ecommerce NA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #000000;
            --secondary: #ffffff;
            --accent: #ff6b00;
            --surface: #f8f8f8;
            --border: #e0e0e0;
            --success: #2e7d32;
            --nav-h: 80px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; font-family: 'Inter', sans-serif; }
        body { background: var(--surface); color: var(--primary); -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }

        header {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            height: var(--nav-h); display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .nav-brand { font-size: 1.5rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: -0.02em; }

        .confirm-page {
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: calc(var(--nav-h) + 40px) 20px 80px;
        }

        .confirm-card {
            background: var(--secondary); border: 1px solid var(--border);
            border-radius: 12px; padding: 60px 40px;
            max-width: 600px; width: 100%; text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            animation: popIn 0.5s ease both;
        }

        .check-circle {
            width: 80px; height: 80px; border-radius: 50%;
            background: #e8f5e9; border: 2px solid #c8e6c9;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 30px;
            animation: scaleIn 0.5s ease 0.2s both;
        }
        .check-circle svg { color: var(--success); }

        .confirm-eyebrow { font-size: 0.9rem; font-weight: 600; text-transform: uppercase; color: var(--success); margin-bottom: 10px; letter-spacing: 0.05em; }
        .confirm-title { font-size: 2.5rem; font-weight: 700; color: var(--primary); margin-bottom: 15px; letter-spacing: -0.02em; }
        .confirm-sub { font-size: 1.05rem; color: #555; line-height: 1.6; margin-bottom: 40px; }

        .pedido-info { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 25px; margin-bottom: 40px; text-align: left; }
        .info-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 0.95rem; }
        .info-row:last-child { border-bottom: none; padding-bottom: 0; }
        .info-row:first-child { padding-top: 0; }
        .info-row .lbl { color: #666; font-weight: 500; }
        .info-row .val { color: var(--primary); font-weight: 600; text-align: right; }
        .info-row .val.accent { color: var(--accent); font-size: 1.1rem; font-weight: 700; }

        .btn-home {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
            padding: 1rem 2.5rem;
            background: var(--primary); color: var(--secondary);
            font-size: 1rem; font-weight: 600; text-decoration: none; border-radius: 9999px;
            transition: all 0.3s;
        }
        .btn-home:hover { background: #333; transform: translateY(-2px); }

        @@keyframes popIn {
            from { opacity: 0; transform: scale(0.95) translateY(20px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        @@keyframes scaleIn {
            from { transform: scale(0); opacity: 0; }
            to   { transform: scale(1); opacity: 1; }
        }

        @@media (max-width: 600px) {
            .confirm-card { padding: 40px 20px; border: none; box-shadow: none; background: transparent; }
            header { padding: 0 20px; }
            .pedido-info { padding: 20px 15px; }
            .info-row { flex-direction: column; gap: 5px; align-items: flex-start; }
            .info-row .val { text-align: left; }
        }
    </style>
</head>
<body>
    <header>
        <a href="/" class="nav-brand">Ecommerce NA</a>
    </header>

    <div class="confirm-page">
        <div class="confirm-card">
            <div class="check-circle">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>

            <div class="confirm-eyebrow">Pedido recibido</div>
            <h1 class="confirm-title">¡Gracias por tu compra!</h1>
            <p class="confirm-sub">Tu pedido ha sido procesado exitosamente. Recibirás actualizaciones sobre el estado de tu envío por correo.</p>

            <div class="pedido-info">
                <div class="info-row">
                    <span class="lbl">Número de pedido</span>
                    <span class="val">#@Model.Id</span>
                </div>
                <div class="info-row">
                    <span class="lbl">Fecha</span>
                    <span class="val">@Model.FechaPedido.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="lbl">Método de envío</span>
                    <span class="val">@(Model.MetodoEnvio?.Nombre ?? "Estándar")</span>
                </div>
                <div class="info-row">
                    <span class="lbl">Total pagado</span>
                    <span class="val accent">$@Model.Total.ToString("N2")</span>
                </div>
                <div class="info-row">
                    <span class="lbl">Estado</span>
                    <span class="val" style="color:var(--success)">✓ Procesando</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.DireccionEnvioSnapshot))
                {
                    <div class="info-row">
                        <span class="lbl">Dirección de envío</span>
                        <span class="val" style="max-width: 250px; line-height: 1.4;">@Model.DireccionEnvioSnapshot</span>
                    </div>
                }
            </div>

            <a href="/" class="btn-home">
                Ir a inicio
            </a>
        </div>
    </div>
</body>
</html>
