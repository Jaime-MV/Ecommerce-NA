@{
    ViewData["Title"] = "Inventario";
    ViewData["ActivePage"] = "Inventario";
}

<div class="page-header animate-fade-up">
    <div>
        <h1 class="page-title">Inventario</h1>
        <p class="page-subtitle">Control de stock por talla y color para cada modelo</p>
    </div>
    <div class="page-actions">
        <button class="btn-admin btn-primary" onclick="openCreateModal()">
            <i data-lucide="plus" style="width:16px;height:16px;"></i>
            Nueva Variante
        </button>
    </div>
</div>

<!-- Product Selector -->
<div class="table-card animate-fade-up" style="animation-delay:80ms; margin-bottom:20px; overflow:visible; position:relative; z-index:50;">
    <div class="table-toolbar" style="border-bottom:none; overflow:visible;">
        <div class="table-toolbar-left" style="flex:1;">
            <div class="form-group" style="margin:0; width:100%; max-width:400px; position:relative;">
                <label class="form-label">Buscar y seleccionar producto</label>
                <div class="search-box" style="margin:0; width: 100%; position:relative; display:flex; align-items:center;">
                    <i data-lucide="search" style="position:absolute; left:12px; width:18px; height:18px; color:var(--text-secondary, #9ca3af);"></i>
                    <input type="text" class="form-input" id="searchProductInput" placeholder="Ej: Escribe para buscar..." oninput="handleAutocomplete()" onfocus="showAutocomplete()" onblur="hideAutocomplete()" autocomplete="off" style="padding-left:36px; width:100%;" />
                    <!-- Hidden input to store real ID -->
                    <input type="hidden" id="productoSelector" onchange="loadVariantes()" />
                </div>
                
                <!-- Autocomplete Dropdown -->
                <div id="autocompleteDropdown" style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; max-height:220px; overflow-y:auto; background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md); box-shadow:var(--shadow-md); z-index:100;">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Variantes Table -->
<div class="table-card animate-fade-up" style="animation-delay:160ms;" id="variantesCard">
    <div class="table-toolbar">
        <div class="table-toolbar-left" style="display:flex; align-items:center; gap: 16px;">
            <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:700;margin:0;">
                Variantes del producto
            </h3>
        </div>
        <div class="table-toolbar-right" style="display:flex; align-items:center; gap: 12px; flex-wrap:wrap;">
            <div class="search-box" style="margin:0; width: 220px; position:relative; display:flex; align-items:center;">
                <i data-lucide="search" style="position:absolute; left:12px; width:16px; height:16px; color:var(--text-secondary, #9ca3af);"></i>
                <input type="text" class="form-input" id="searchInput" placeholder="Buscar talla o color..." oninput="applyFilters()" disabled style="padding-left:36px; width:100%; margin:0;" />
            </div>
            <button class="btn-admin btn-secondary btn-sm" id="btnSort" onclick="toggleSort()" disabled title="Ordenar por Stock">
                <i id="sortIcon" data-lucide="arrow-up-down" style="width:15px;height:15px;"></i> Stock
            </button>
            <span class="cell-muted" style="font-size:0.82rem; margin-left: 8px;" id="totalCount"></span>
        </div>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Talla</th>
                <th>Color</th>
                <th>Stock</th>
                <th>Estado</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>
        <tbody id="variantesBody">
            <tr>
                <td colspan="6">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i data-lucide="warehouse"></i></div>
                        <div class="empty-state-title">Selecciona un producto</div>
                        <div class="empty-state-desc">Elige un producto arriba para ver y gestionar sus variantes de inventario.</div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Create Variante Modal -->
<div class="modal-overlay" id="varianteModal">
    <div class="modal-container" style="max-width:480px;">
        <div class="modal-header">
            <h3 class="modal-title">Nueva Variante</h3>
            <button class="modal-close" onclick="closeModal('varianteModal')"><i data-lucide="x"></i></button>
        </div>
        <div class="modal-body">
            <form id="varianteForm" onsubmit="handleCreateVariante(event)">
                <div class="form-group">
                    <label class="form-label">Producto</label>
                    <select class="form-input" id="varianteProductoId" required>
                        <option value="">Seleccionar...</option>
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="talla">Talla *</label>
                        <input type="text" class="form-input" id="talla" placeholder="Ej: 42, 38, M..." required maxlength="10" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="color">Color *</label>
                        <input type="text" class="form-input" id="color" placeholder="Ej: Negro, Rojo..." required maxlength="30" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="stock">Stock inicial *</label>
                    <input type="number" class="form-input" id="stock" placeholder="0" required min="0" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-admin btn-secondary" onclick="closeModal('varianteModal')">Cancelar</button>
            <button class="btn-admin btn-primary" onclick="document.getElementById('varianteForm').requestSubmit()">
                <i data-lucide="save" style="width:15px;height:15px;"></i> Guardar
            </button>
        </div>
    </div>
</div>

<!-- Edit Stock Modal -->
<div class="modal-overlay" id="stockModal">
    <div class="modal-container" style="max-width:400px;">
        <div class="modal-header">
            <h3 class="modal-title">Actualizar Stock</h3>
            <button class="modal-close" onclick="closeModal('stockModal')"><i data-lucide="x"></i></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="stockVarianteId" />
            <p style="font-size:0.88rem;color:var(--text-secondary);margin-bottom:16px;" id="stockInfo"></p>
            <div class="form-group">
                <label class="form-label" for="nuevoStock">Nuevo stock</label>
                <input type="number" class="form-input" id="nuevoStock" placeholder="0" min="0" />
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-admin btn-secondary" onclick="closeModal('stockModal')">Cancelar</button>
            <button class="btn-admin btn-primary" onclick="updateStock()">
                <i data-lucide="refresh-cw" style="width:15px;height:15px;"></i> Actualizar
            </button>
        </div>
    </div>
</div>

<style>
.autocomplete-item {
    padding: 10px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.95rem;
    transition: background 0.2s ease;
}
.autocomplete-item:last-child {
    border-bottom: none;
}
.autocomplete-item:hover {
    background-color: var(--bg-hover, #f3f4f6);
}
.autocomplete-empty {
    padding: 10px 14px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-style: italic;
}
</style>

@section Scripts {
<script>
let allProductos = [];
let currentVariantes = [];
let sortDirection = 0; // 0 = Normal, 1 = Asc (Menor a Mayor), 2 = Desc (Mayor a Menor)

document.addEventListener('DOMContentLoaded', () => loadProductos());

async function loadProductos() {
    try {
        allProductos = await apiGet('productos');
        
        // Poblar el select del modal de creación con todos siempre
        const modalOptions = allProductos.map(p => `<option value="${p.id}">${esc(p.nombre)}</option>`).join('');
        document.getElementById('varianteProductoId').innerHTML = '<option value="">Seleccionar...</option>' + modalOptions;
    } catch (e) {
        showToast('Error al cargar productos: ' + e.message, 'error');
    }
}

function handleAutocomplete() {
    const term = document.getElementById('searchProductInput').value.toLowerCase().trim();
    
    // Limpiamos la seleccion actual del input oculto si el usuario altera el texto
    const currentSelectedName = document.getElementById('searchProductInput').dataset.selectedName || '';
    if (document.getElementById('searchProductInput').value !== currentSelectedName) {
        document.getElementById('productoSelector').value = "";
        document.getElementById('searchProductInput').dataset.selectedName = "";
    }

    if (!term) {
        renderAutocomplete(allProductos);
        return;
    }

    const filtered = allProductos.filter(p => p.nombre.toLowerCase().includes(term));
    renderAutocomplete(filtered);
}

function showAutocomplete() {
    document.getElementById('autocompleteDropdown').style.display = 'block';
    handleAutocomplete();
}

function hideAutocomplete() {
    // Retraso para permitir hacer clic en la opcion
    setTimeout(() => {
        document.getElementById('autocompleteDropdown').style.display = 'none';
        const input = document.getElementById('searchProductInput');
        const hiddenId = document.getElementById('productoSelector').value;
        
        // Si no slecciono nada y se salio, borramos
        if (!hiddenId) {
            input.value = '';
            loadVariantes(); // limpia la tabla
        } else {
            // Restaura el nombre si escribió basura
            input.value = input.dataset.selectedName || '';
        }
    }, 200);
}

function renderAutocomplete(list) {
    const dropdown = document.getElementById('autocompleteDropdown');
    
    if (list.length === 0) {
        dropdown.innerHTML = '<div class="autocomplete-empty">No se encontraron productos...</div>';
        return;
    }

    dropdown.innerHTML = list.map(p => 
        `<div class="autocomplete-item" onclick="selectProduct(${p.id}, '${esc(p.nombre).replace(/'/g, "\\'")}')">
            ${esc(p.nombre)}
        </div>`
    ).join('');
}

function selectProduct(id, nombre) {
    const input = document.getElementById('searchProductInput');
    input.value = nombre;
    input.dataset.selectedName = nombre;
    
    document.getElementById('productoSelector').value = id;
    document.getElementById('autocompleteDropdown').style.display = 'none';
    
    loadVariantes(); // Cargar data real
}

async function loadVariantes() {
    const productoId = document.getElementById('productoSelector').value;
    if (!productoId) {
        document.getElementById('searchInput').disabled = true;
        document.getElementById('btnSort').disabled = true;
        document.getElementById('variantesBody').innerHTML = `
            <tr><td colspan="6"><div class="empty-state">
                <div class="empty-state-icon"><i data-lucide="warehouse"></i></div>
                <div class="empty-state-title">Selecciona un producto</div>
                <div class="empty-state-desc">Elige un producto para gestionar su inventario.</div>
            </div></td></tr>`;
        lucide.createIcons();
        return;
    }

    showTableSkeleton('variantesBody', 6);
    try {
        currentVariantes = await apiGet(`productos/${productoId}/variantes`);
        document.getElementById('searchInput').disabled = currentVariantes.length === 0;
        document.getElementById('btnSort').disabled = currentVariantes.length === 0;
        applyFilters();
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function toggleSort() {
    sortDirection = (sortDirection + 1) % 3;
    const btnIcon = document.getElementById('sortIcon');
    if (sortDirection === 0) {
        btnIcon.setAttribute('data-lucide', 'arrow-up-down'); // Original
    } else if (sortDirection === 1) {
        btnIcon.setAttribute('data-lucide', 'arrow-down-0-1'); // Menor a mayor
    } else {
        btnIcon.setAttribute('data-lucide', 'arrow-up-1-0'); // Mayor a menor
    }
    lucide.createIcons({ nodes: [document.getElementById('btnSort')] });
    applyFilters();
}

function applyFilters() {
    if (!currentVariantes) return;
    
    const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
    let filtered = [...currentVariantes];
    
    // Aplicar búsqueda
    if (searchTerm) {
        filtered = filtered.filter(v => 
            v.talla.toLowerCase().includes(searchTerm) || 
            (v.color && v.color.toLowerCase().includes(searchTerm))
        );
    }
    
    // Aplicar ordenamiento
    if (sortDirection === 1) {
        filtered.sort((a, b) => a.stock - b.stock);
    } else if (sortDirection === 2) {
        filtered.sort((a, b) => b.stock - a.stock);
    }

    renderVariantes(filtered);
}

function renderVariantes(data = currentVariantes) {
    const tbody = document.getElementById('variantesBody');
    document.getElementById('totalCount').textContent = `${data.length} variante${data.length !== 1 ? 's' : ''}`;

    if (!data.length) {
        const hasFilters = document.getElementById('searchInput').value.trim() !== '';
        if (hasFilters) {
            showEmptyState('variantesBody', 'search-x', 'Sin resultados', 'Ninguna variante coincide con tu búsqueda.');
        } else {
            showEmptyState('variantesBody', 'package-open', 'Sin variantes', 'Este producto no tiene variantes registradas.',
                '<button class="btn-admin btn-primary btn-sm" onclick="openCreateModal()"><i data-lucide="plus" style="width:14px;height:14px;"></i> Agregar</button>');
        }
        return;
    }

    tbody.innerHTML = data.map(v => {
        const stockClass = v.stock === 0 ? 'badge--danger' : (v.stock <= 5 ? 'badge--warning' : 'badge--success');
        const stockLabel = v.stock === 0 ? 'Agotado' : (v.stock <= 5 ? 'Bajo' : 'Disponible');
        return `
        <tr>
            <td class="cell-muted">#${v.id}</td>
            <td class="cell-bold">${esc(v.talla)}</td>
            <td>
                <div class="variant-tag">
                    <span class="variant-color-dot" style="background:${getColorHex(v.color)};"></span>
                    ${esc(v.color)}
                </div>
            </td>
            <td class="cell-bold">${v.stock}</td>
            <td>
                <span class="badge ${stockClass}"><span class="badge-dot"></span>${stockLabel}</span>
                ${!v.activo ? '<span class="badge badge--neutral" style="margin-left:4px;">Inactivo</span>' : ''}
            </td>
            <td>
                <div class="cell-actions">
                    <button class="btn-admin btn-ghost btn-icon" title="Editar stock" onclick="openStockModal(${v.id}, '${esc(v.talla)}', '${esc(v.color)}', ${v.stock})">
                        <i data-lucide="pencil" style="width:15px;height:15px;"></i>
                    </button>
                    <button class="btn-admin btn-danger btn-icon" title="Desactivar" onclick="confirmDesactivar(${v.id}, '${esc(v.talla)}', '${esc(v.color)}')">
                        <i data-lucide="power-off" style="width:15px;height:15px;"></i>
                    </button>
                </div>
            </td>
        </tr>
    `}).join('');
    lucide.createIcons();
}

function openCreateModal() {
    const selProd = document.getElementById('productoSelector').value;
    if (selProd) document.getElementById('varianteProductoId').value = selProd;
    document.getElementById('talla').value = '';
    document.getElementById('color').value = '';
    document.getElementById('stock').value = '';
    openModal('varianteModal');
}

async function handleCreateVariante(e) {
    e.preventDefault();
    const data = {
        productoId: parseInt(document.getElementById('varianteProductoId').value),
        talla: document.getElementById('talla').value.trim(),
        color: document.getElementById('color').value.trim(),
        stock: parseInt(document.getElementById('stock').value)
    };
    try {
        await apiPost('variantes', data);
        showToast('Variante creada correctamente', 'success');
        closeModal('varianteModal');
        document.getElementById('productoSelector').value = data.productoId;
        await loadVariantes();
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function openStockModal(id, talla, color, stock) {
    document.getElementById('stockVarianteId').value = id;
    document.getElementById('stockInfo').innerHTML = `Talla: <strong>${talla}</strong> — Color: <strong>${color}</strong> — Stock actual: <strong>${stock}</strong>`;
    document.getElementById('nuevoStock').value = stock;
    openModal('stockModal');
}

async function updateStock() {
    const id = document.getElementById('stockVarianteId').value;
    const nuevoStock = parseInt(document.getElementById('nuevoStock').value);
    try {
        await apiPatch(`variantes/${id}/stock`, nuevoStock);
        showToast('Stock actualizado', 'success');
        closeModal('stockModal');
        await loadVariantes();
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

function confirmDesactivar(id, talla, color) {
    showConfirm('Desactivar Variante',
        `¿Seguro que deseas desactivar la variante <strong class="confirm-strong">Talla ${talla} / ${color}</strong>?`,
        async () => {
            try {
                await apiDelete(`variantes/${id}`);
                showToast('Variante desactivada', 'success');
                await loadVariantes();
            } catch (e) { showToast('Error: ' + e.message, 'error'); }
        },
        { danger: true, confirmText: 'Desactivar' }
    );
}

function getColorHex(colorName) {
    const colors = {
        'negro': '#1a1a1a', 'blanco': '#f5f5f5', 'rojo': '#ef4444', 'azul': '#3b82f6',
        'verde': '#22c55e', 'amarillo': '#eab308', 'naranja': '#f97316', 'morado': '#a855f7',
        'rosa': '#ec4899', 'café': '#92400e', 'gris': '#6b7280', 'marrón': '#92400e',
        'beige': '#d4a574', 'dorado': '#d4a520'
    };
    return colors[colorName.toLowerCase()] || '#6b697a';
}

function esc(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
}
</script>
}
